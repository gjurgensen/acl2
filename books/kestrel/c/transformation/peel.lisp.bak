;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(in-package "C2C")

(include-book "std/util/define" :dir :system)
(include-book "std/util/defrule" :dir :system)
(include-book "std/util/error-value-tuples" :dir :system)

(include-book "centaur/fty/deftypes" :dir :system)

(include-book "kestrel/utilities/messages" :dir :system)

(include-book "../syntax/abstract-syntax-operations")
(include-book "../syntax/code-ensembles")
(include-book "../syntax/unambiguity")
(include-book "../syntax/validation-information")
(include-book "utilities/collect-idents")
(include-book "utilities/fresh-ident")

(include-book "std/basic/controlled-configuration" :dir :system)
(acl2::controlled-configuration)

(local (include-book "kestrel/utilities/ordinals" :dir :system))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(fty::deftagsum direction
  (:left ())
  (:right ())
  :pred directionp
  ;; Note: fulltree is not documented
  :layout :fulltree)

(fty::defoption direction-option
  direction
  :pred direction-optionp)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(fty::defomap uid-ident-map
  :key-type c$::uid
  :val-type ident
  :pred uid-ident-mapp)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
#|
(include-book "kestrel/fty/deffold-map" :dir :system)
(include-book "kestrel/fty/deffold-map-doc" :dir :system)

(fty::deffold-map peel
  :types (c$::exprs/decls/stmts)
  :extra-args
  ((dir? direction-optionp)
   ;; Note: we don't need to map to an identifier pair; the left identifier is
   ;; implicit, since we don't change the name.
   (objs uid-ident-mapp)))
|#
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
#|
(defines exprs/decls/stmts-peel
  (define expr-peel ((expr exprp)
                     (dir? direction-optionp)
                     (objs uid-ident-mapp))
    :returns (result exprp)
    (expr-case
     expr
     :ident (expr-fix expr)
     :const (expr-fix expr)
     :string (expr-fix expr)
     :paren
     (expr-paren (expr-peel (c$::expr-paren->inner expr)
                            dir? objs))
     :gensel
     (c$::expr-gensel
       (expr-peel (c$::expr-gensel->control expr)
                  dir? objs)
       (genassoc-list-peel (c$::expr-gensel->assocs expr)
                           dir? objs))
     :arrsub (c$::expr-arrsub
               (expr-peel (c$::expr-arrsub->arg1 expr)
                          dir? objs)
               (expr-peel (c$::expr-arrsub->arg2 expr)
                          dir? objs)
               (c$::expr-arrsub->info expr))
     :funcall
     (c$::expr-funcall
       (expr-peel (c$::expr-funcall->fun expr)
                  dir? objs)
       (expr-list-peel (c$::expr-funcall->args expr)
                       dir? objs)
       (c$::expr-funcall->info expr))
     :member (c$::expr-member
               (expr-peel (c$::expr-member->arg expr)
                          dir? objs)
               (c$::expr-member->name expr))
     :memberp (c$::expr-memberp
                (expr-peel (c$::expr-memberp->arg expr)
                           dir? objs)
                (c$::expr-memberp->name expr))
     :complit
     (c$::expr-complit
       (tyname-peel (c$::expr-complit->type expr)
                    dir? objs)
       (desiniter-list-peel (c$::expr-complit->elems expr)
                            dir? objs)
       (c$::expr-complit->final-comma expr))
     :unary
     (expr-unary (c$::expr-unary->op expr)
                 (expr-peel (c$::expr-unary->arg expr)
                            dir? objs)
                 (c$::expr-unary->info expr))
     :label-addr (expr-fix expr)
     :sizeof
     (expr-sizeof
       (tyname-peel (c$::expr-sizeof->type expr)
                    dir? objs))
     :alignof
     (expr-alignof
       (tyname-peel (c$::expr-alignof->type expr)
                    dir? objs)
       (c$::expr-alignof->uscores expr))
     :cast
     (expr-cast (tyname-peel (c$::expr-cast->type expr)
                             dir? objs)
                (expr-peel (c$::expr-cast->arg expr)
                           dir? objs))
     :binary
     (expr-binary (expr-binary->op expr)
                  (expr-peel (expr-binary->arg1 expr)
                             dir? objs)
                  (expr-peel (expr-binary->arg2 expr)
                             dir? objs)
                  (c$::expr-binary->info expr))
     :cond
     (expr-cond
       (expr-peel (c$::expr-cond->test expr)
                  dir? objs)
       (expr-option-peel (c$::expr-cond->then expr)
                         dir? objs)
       (expr-peel (c$::expr-cond->else expr)
                  dir? objs))
     :comma (c$::expr-comma
              (expr-peel (c$::expr-comma->first expr)
                         dir? objs)
              (expr-peel (c$::expr-comma->next expr)
                         dir? objs))
     :stmt
     (expr-stmt (comp-stmt-peel (c$::expr-stmt->stmt expr)
                                dir? objs))
     :tycompat
     (c$::expr-tycompat
       (tyname-peel (c$::expr-tycompat->type1 expr)
                    dir? objs)
       (tyname-peel (c$::expr-tycompat->type2 expr)
                    dir? objs))
     :offsetof
     (c$::expr-offsetof
       (tyname-peel (c$::expr-offsetof->type expr)
                    dir? objs)
       (member-designor-peel
         (c$::expr-offsetof->member expr)
         dir? objs))
     :va-arg
     (c$::expr-va-arg
       (expr-peel (c$::expr-va-arg->list expr)
                  dir? objs)
       (tyname-peel (c$::expr-va-arg->type expr)
                    dir? objs))
     :extension
     (expr-extension
       (expr-peel (c$::expr-extension->expr expr)
                  dir? objs))
     :sizeof-ambig (expr-fix expr)
     :alignof-ambig (expr-fix expr)
     :cast/call-ambig (expr-fix expr)
     :cast/mul-ambig (expr-fix expr)
     :cast/add-ambig (expr-fix expr)
     :cast/sub-ambig (expr-fix expr)
     :cast/and-ambig (expr-fix expr)
     :cast/logand-ambig (expr-fix expr))
    :measure (expr-count expr))

  (define expr-list-peel ((expr-list expr-listp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result expr-listp)
    (if (endp expr-list)
        nil
      (cons (expr-peel (car expr-list)
                       dir? objs)
            (expr-list-peel (cdr expr-list)
                            dir? objs)))
    :measure (expr-list-count expr-list))


  (define expr-option-peel ((expr-option expr-optionp)
                            (dir? direction-optionp)
                            (objs uid-ident-mapp))
    :returns (result expr-optionp)
    (expr-option-case
     expr-option
     :some
     (expr-fix
       (expr-peel (expr-option-some->val expr-option)
                  dir? objs))
     :none nil)
    :measure (expr-option-count expr-option))

  (define const-expr-peel ((const-expr const-exprp)
                           (dir? direction-optionp)
                           (objs uid-ident-mapp))
    :returns (result const-exprp)
    (const-expr (expr-peel (const-expr->expr const-expr)
                           dir? objs))
    :measure (const-expr-count const-expr))

  (define const-expr-option-peel
    ((const-expr-option const-expr-optionp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result const-expr-optionp)
    (const-expr-option-case
     const-expr-option
     :some (c$::const-expr-fix
             (const-expr-peel
               (c$::const-expr-option-some->val const-expr-option)
               dir? objs))
     :none nil)
    :measure (const-expr-option-count const-expr-option))

  (define genassoc-peel ((genassoc genassocp)
                         (dir? direction-optionp)
                         (objs uid-ident-mapp))
    :returns (result genassocp)
    (genassoc-case
     genassoc
     :type
     (c$::genassoc-type
       (tyname-peel (c$::genassoc-type->type genassoc)
                    dir? objs)
       (expr-peel (c$::genassoc-type->expr genassoc)
                  dir? objs))
     :default
     (genassoc-default
       (expr-peel (c$::genassoc-default->expr genassoc)
                  dir? objs)))
    :measure (genassoc-count genassoc))

  (define genassoc-list-peel
    ((genassoc-list genassoc-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result genassoc-listp)
    (if (endp genassoc-list)
        nil
      (cons (genassoc-peel (car genassoc-list)
                           dir? objs)
            (genassoc-list-peel (cdr genassoc-list)
                                dir? objs)))
    :measure (genassoc-list-count genassoc-list))

  (define member-designor-peel
    ((member-designor member-designorp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result member-designorp)
    (member-designor-case
     member-designor
     :ident (member-designor-fix member-designor)
     :dot (c$::member-designor-dot
            (member-designor-peel
              (c$::member-designor-dot->member member-designor)
              dir? objs)
            (c$::member-designor-dot->name member-designor))
     :sub (c$::member-designor-sub
            (member-designor-peel
              (c$::member-designor-sub->member member-designor)
              dir? objs)
            (expr-peel
              (c$::member-designor-sub->index member-designor)
              dir? objs)))
    :measure (member-designor-count member-designor))

  (define type-spec-peel ((type-spec type-specp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result type-specp)
    (type-spec-case
     type-spec
     :void (type-spec-fix type-spec)
     :char (type-spec-fix type-spec)
     :short (type-spec-fix type-spec)
     :int (type-spec-fix type-spec)
     :long (type-spec-fix type-spec)
     :float (type-spec-fix type-spec)
     :double (type-spec-fix type-spec)
     :signed (type-spec-fix type-spec)
     :unsigned (type-spec-fix type-spec)
     :bool (type-spec-fix type-spec)
     :complex (type-spec-fix type-spec)
     :atomic
     (type-spec-atomic
       (tyname-peel (c$::type-spec-atomic->type type-spec)
                    dir? objs))
     :struct (type-spec-struct (struni-spec-peel
                                 (c$::type-spec-struct->spec type-spec)
                                 dir? objs))
     :union (type-spec-union (struni-spec-peel
                               (c$::type-spec-union->spec type-spec)
                               dir? objs))
     :enum
     (type-spec-enum
       (enum-spec-peel (c$::type-spec-enum->spec type-spec)
                       dir? objs))
     :typedef (type-spec-fix type-spec)
     :int128 (type-spec-fix type-spec)
     :locase-float80 (type-spec-fix type-spec)
     :locase-float128 (type-spec-fix type-spec)
     :float16 (type-spec-fix type-spec)
     :float16x (type-spec-fix type-spec)
     :float32 (type-spec-fix type-spec)
     :float32x (type-spec-fix type-spec)
     :float64 (type-spec-fix type-spec)
     :float64x (type-spec-fix type-spec)
     :float128 (type-spec-fix type-spec)
     :float128x (type-spec-fix type-spec)
     :builtin-va-list (type-spec-fix type-spec)
     :struct-empty
     (c$::type-spec-struct-empty
       (attrib-spec-list-peel
         (c$::type-spec-struct-empty->attribs type-spec)
         dir? objs)
       (c$::type-spec-struct-empty->name? type-spec))
     :typeof-expr (c$::type-spec-typeof-expr
                    (expr-peel
                      (c$::type-spec-typeof-expr->expr type-spec)
                      dir? objs)
                    (c$::type-spec-typeof-expr->uscores type-spec))
     :typeof-type (c$::type-spec-typeof-type
                    (tyname-peel
                      (c$::type-spec-typeof-type->type type-spec)
                      dir? objs)
                    (c$::type-spec-typeof-type->uscores type-spec))
     :auto-type (type-spec-fix type-spec)
     :typeof-ambig (type-spec-fix type-spec))
    :measure (type-spec-count type-spec))

  (define spec/qual-peel ((spec/qual spec/qual-p)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result spec/qual-p)
    (spec/qual-case
     spec/qual
     :typespec
     (spec/qual-typespec (type-spec-peel
                           (c$::spec/qual-typespec->spec spec/qual)
                           dir? objs))
     :typequal (spec/qual-fix spec/qual)
     :align (spec/qual-align (align-spec-peel
                               (c$::spec/qual-align->spec spec/qual)
                               dir? objs))
     :attrib (spec/qual-attrib (attrib-spec-peel
                                 (c$::spec/qual-attrib->spec spec/qual)
                                 dir? objs)))
    :measure (spec/qual-count spec/qual))

  (define spec/qual-list-peel
    ((specqual-list spec/qual-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result spec/qual-listp)
    (if (endp specqual-list)
        nil
      (cons (spec/qual-peel (car specqual-list)
                            dir? objs)
            (spec/qual-list-peel (cdr specqual-list)
                                 dir? objs)))
    :measure (spec/qual-list-count specqual-list))

  (define align-spec-peel ((align-spec align-specp)
                           (dir? direction-optionp)
                           (objs uid-ident-mapp))
    :returns (result align-specp)
    (align-spec-case
     align-spec
     :alignas-type
     (align-spec-alignas-type
       (tyname-peel
         (c$::align-spec-alignas-type->type align-spec)
         dir? objs))
     :alignas-expr
     (align-spec-alignas-expr
       (const-expr-peel
         (c$::align-spec-alignas-expr->expr align-spec)
         dir? objs))
     :alignas-ambig (align-spec-fix align-spec))
    :measure (align-spec-count align-spec))

  (define decl-spec-peel ((decl-spec decl-specp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result decl-specp)
    (decl-spec-case
     decl-spec
     :stoclass (decl-spec-fix decl-spec)
     :typespec
     (decl-spec-typespec (type-spec-peel
                           (c$::decl-spec-typespec->spec decl-spec)
                           dir? objs))
     :typequal (decl-spec-fix decl-spec)
     :function (decl-spec-fix decl-spec)
     :align (decl-spec-align (align-spec-peel
                               (c$::decl-spec-align->spec decl-spec)
                               dir? objs))
     :attrib (decl-spec-attrib (attrib-spec-peel
                                 (c$::decl-spec-attrib->spec decl-spec)
                                 dir? objs))
     :stdcall (decl-spec-fix decl-spec)
     :declspec (decl-spec-fix decl-spec))
    :measure (decl-spec-count decl-spec))

  (define decl-spec-list-peel
    ((decl-spec-list decl-spec-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result decl-spec-listp)
    (if (endp decl-spec-list)
        nil
      (cons (decl-spec-peel (car decl-spec-list)
                            dir? objs)
            (decl-spec-list-peel (cdr decl-spec-list)
                                 dir? objs)))
    :measure (decl-spec-list-count decl-spec-list))

  (define typequal/attribspec-peel
    ((typequal/attribspec c$::typequal/attribspec-p)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result c$::typequal/attribspec-p)
    (c$::typequal/attribspec-case
     typequal/attribspec
     :type (c$::typequal/attribspec-fix typequal/attribspec)
     :attrib
     (c$::typequal/attribspec-attrib
       (attrib-spec-peel
         (c$::typequal/attribspec-attrib->spec typequal/attribspec)
         dir? objs)))
    :measure (c$::typequal/attribspec-count typequal/attribspec))

  (define typequal/attribspec-list-peel
    ((typequal/attribspec-list c$::typequal/attribspec-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result c$::typequal/attribspec-listp)
    (if (endp typequal/attribspec-list)
        nil
      (cons (typequal/attribspec-peel
              (car typequal/attribspec-list)
              dir? objs)
            (typequal/attribspec-list-peel
              (cdr typequal/attribspec-list)
              dir? objs)))
    :measure (c$::typequal/attribspec-list-count typequal/attribspec-list))

  (define typequal/attribspec-list-list-peel
    ((typequal/attribspec-list-list typequal/attribspec-list-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result typequal/attribspec-list-listp)
    (if (endp typequal/attribspec-list-list)
        nil
      (cons (typequal/attribspec-list-peel
              (car typequal/attribspec-list-list)
              dir? objs)
            (typequal/attribspec-list-list-peel
              (cdr typequal/attribspec-list-list)
              dir? objs)))
    :measure (c$::typequal/attribspec-list-list-count
              typequal/attribspec-list-list))

  (define initer-peel ((initer initerp)
                       (dir? direction-optionp)
                       (objs uid-ident-mapp))
    :returns (result initerp)
    (initer-case
     initer
     :single
     (initer-single
       (expr-peel (c$::initer-single->expr initer)
                  dir? objs))
     :list
     (c$::initer-list
       (desiniter-list-peel (c$::initer-list->elems initer)
                            dir? objs)
       (c$::initer-list->final-comma initer)))
    :measure (initer-count initer))

  (define initer-option-peel
    ((initer-option initer-optionp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result initer-optionp)
    (initer-option-case
     initer-option
     :some (initer-fix (initer-peel
                         (c$::initer-option-some->val initer-option)
                         dir? objs))
     :none nil)
    :measure (initer-option-count initer-option))

  (define desiniter-peel ((desiniter desiniterp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result desiniterp)
    (desiniter
     (designor-list-peel (c$::desiniter->designors desiniter)
                         dir? objs)
     (initer-peel (c$::desiniter->initer desiniter)
                  dir? objs))
    :measure (desiniter-count desiniter))

  (define desiniter-list-peel
    ((desiniter-list desiniter-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result desiniter-listp)
    (if (endp desiniter-list)
        nil
      (cons (desiniter-peel (car desiniter-list)
                            dir? objs)
            (desiniter-list-peel (cdr desiniter-list)
                                 dir? objs)))
    :measure (desiniter-list-count desiniter-list))

  (define designor-peel ((designor designorp)
                         (dir? direction-optionp)
                         (objs uid-ident-mapp))
    :returns (result designorp)
    (designor-case
     designor
     :sub
     (c$::designor-sub
       (const-expr-peel (c$::designor-sub->index designor)
                        dir? objs)
       (const-expr-option-peel
         (c$::designor-sub->range? designor)
         dir? objs))
     :dot (designor-fix designor))
    :measure (designor-count designor))

  (define designor-list-peel
    ((designor-list designor-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result designor-listp)
    (if (endp designor-list)
        nil
      (cons (designor-peel (car designor-list)
                           dir? objs)
            (designor-list-peel (cdr designor-list)
                                dir? objs)))
    :measure (designor-list-count designor-list))

  (define declor-peel ((declor declorp)
                       (dir? direction-optionp)
                       (objs uid-ident-mapp))
    :returns (result declorp)
    (declor (typequal/attribspec-list-list-peel
              (c$::declor->pointers declor)
              dir? objs)
            (dirdeclor-peel (declor->direct declor)
                            dir? objs))
    :measure (declor-count declor))

  (define declor-option-peel
    ((declor-option declor-optionp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result declor-optionp)
    (declor-option-case
     declor-option
     :some (declor-fix (declor-peel
                         (c$::declor-option-some->val declor-option)
                         dir? objs))
     :none nil)
    :measure (declor-option-count declor-option))

  (define dirdeclor-peel ((dirdeclor dirdeclorp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result dirdeclorp)
    (dirdeclor-case
     dirdeclor
     :ident (dirdeclor-fix dirdeclor)
     :paren
     (dirdeclor-paren
       (declor-peel (c$::dirdeclor-paren->inner dirdeclor)
                    dir? objs))
     :array
     (c$::dirdeclor-array
       (dirdeclor-peel (c$::dirdeclor-array->declor dirdeclor)
                       dir? objs)
       (typequal/attribspec-list-peel
         (c$::dirdeclor-array->qualspecs dirdeclor)
         dir? objs)
       (expr-option-peel (c$::dirdeclor-array->size? dirdeclor)
                         dir? objs))
     :array-static1
     (c$::dirdeclor-array-static1
       (dirdeclor-peel
         (c$::dirdeclor-array-static1->declor dirdeclor)
         dir? objs)
       (typequal/attribspec-list-peel
         (c$::dirdeclor-array-static1->qualspecs dirdeclor)
         dir? objs)
       (expr-peel (c$::dirdeclor-array-static1->size dirdeclor)
                  dir? objs))
     :array-static2
     (c$::dirdeclor-array-static2
       (dirdeclor-peel
         (c$::dirdeclor-array-static2->declor dirdeclor)
         dir? objs)
       (typequal/attribspec-list-peel
         (c$::dirdeclor-array-static2->qualspecs dirdeclor)
         dir? objs)
       (expr-peel (c$::dirdeclor-array-static2->size dirdeclor)
                  dir? objs))
     :array-star (c$::dirdeclor-array-star
                   (dirdeclor-peel
                     (c$::dirdeclor-array-star->declor dirdeclor)
                     dir? objs)
                   (typequal/attribspec-list-peel
                     (c$::dirdeclor-array-star->qualspecs dirdeclor)
                     dir? objs))
     :function-params
     (c$::dirdeclor-function-params
       (dirdeclor-peel
         (dirdeclor-function-params->declor dirdeclor)
         dir? objs)
       (param-declon-list-peel
         (dirdeclor-function-params->params dirdeclor)
         dir? objs)
       (c$::dirdeclor-function-params->ellipsis dirdeclor))
     :function-names
     (c$::dirdeclor-function-names
       (dirdeclor-peel
         (c$::dirdeclor-function-names->declor dirdeclor)
         dir? objs)
       (dirdeclor-function-names->names dirdeclor)))
    :measure (dirdeclor-count dirdeclor))

  (define absdeclor-peel ((absdeclor absdeclorp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result absdeclorp)
    (absdeclor (typequal/attribspec-list-list-peel
                 (c$::absdeclor->pointers absdeclor)
                 dir? objs)
               (dirabsdeclor-option-peel
                 (c$::absdeclor->direct? absdeclor)
                 dir? objs))
    :measure (absdeclor-count absdeclor))

  (define absdeclor-option-peel
    ((absdeclor-option absdeclor-optionp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result absdeclor-optionp)
    (absdeclor-option-case
     absdeclor-option
     :some
     (absdeclor-fix (absdeclor-peel
                      (c$::absdeclor-option-some->val absdeclor-option)
                      dir? objs))
     :none nil)
    :measure (absdeclor-option-count absdeclor-option))

  (define dirabsdeclor-peel ((dirabsdeclor dirabsdeclorp)
                             (dir? direction-optionp)
                             (objs uid-ident-mapp))
    :returns (result dirabsdeclorp)
    (dirabsdeclor-case
     dirabsdeclor
     :dummy-base (dirabsdeclor-fix dirabsdeclor)
     :paren
     (dirabsdeclor-paren (absdeclor-peel
                           (c$::dirabsdeclor-paren->inner dirabsdeclor)
                           dir? objs))
     :array (c$::dirabsdeclor-array
              (dirabsdeclor-option-peel
                (c$::dirabsdeclor-array->declor? dirabsdeclor)
                dir? objs)
              (typequal/attribspec-list-peel
                (c$::dirabsdeclor-array->qualspecs dirabsdeclor)
                dir? objs)
              (expr-option-peel
                (c$::dirabsdeclor-array->size? dirabsdeclor)
                dir? objs))
     :array-static1
     (c$::dirabsdeclor-array-static1
       (dirabsdeclor-option-peel
         (c$::dirabsdeclor-array-static1->declor? dirabsdeclor)
         dir? objs)
       (typequal/attribspec-list-peel
         (c$::dirabsdeclor-array-static1->qualspecs dirabsdeclor)
         dir? objs)
       (expr-peel
         (c$::dirabsdeclor-array-static1->size dirabsdeclor)
         dir? objs))
     :array-static2
     (c$::dirabsdeclor-array-static2
       (dirabsdeclor-option-peel
         (c$::dirabsdeclor-array-static2->declor? dirabsdeclor)
         dir? objs)
       (typequal/attribspec-list-peel
         (c$::dirabsdeclor-array-static2->qualspecs dirabsdeclor)
         dir? objs)
       (expr-peel
         (c$::dirabsdeclor-array-static2->size dirabsdeclor)
         dir? objs))
     :array-star
     (dirabsdeclor-array-star
       (dirabsdeclor-option-peel
         (c$::dirabsdeclor-array-star->declor? dirabsdeclor)
         dir? objs))
     :function (c$::dirabsdeclor-function
                 (dirabsdeclor-option-peel
                   (c$::dirabsdeclor-function->declor? dirabsdeclor)
                   dir? objs)
                 (param-declon-list-peel
                   (c$::dirabsdeclor-function->params dirabsdeclor)
                   dir? objs)
                 (c$::dirabsdeclor-function->ellipsis dirabsdeclor)))
    :measure (dirabsdeclor-count dirabsdeclor))

  (define dirabsdeclor-option-peel
    ((dirabsdeclor-option dirabsdeclor-optionp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result dirabsdeclor-optionp)
    (dirabsdeclor-option-case
     dirabsdeclor-option
     :some
     (dirabsdeclor-fix
       (dirabsdeclor-peel
         (c$::dirabsdeclor-option-some->val dirabsdeclor-option)
         dir? objs))
     :none nil)
    :measure (dirabsdeclor-option-count dirabsdeclor-option))

  (define param-declon-peel ((param-declon param-declonp)
                             (dir? direction-optionp)
                             (objs uid-ident-mapp))
    :returns (result param-declonp)
    (param-declon (decl-spec-list-peel
                    (c$::param-declon->specs param-declon)
                    dir? objs)
                  (param-declor-peel
                    (c$::param-declon->declor param-declon)
                    dir? objs)
                  (attrib-spec-list-peel
                    (c$::param-declon->attribs param-declon)
                    dir? objs))
    :measure (param-declon-count param-declon))

  (define param-declon-list-peel
    ((param-declon-list param-declon-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result param-declon-listp)
    (if (endp param-declon-list)
        nil
      (cons (param-declon-peel (car param-declon-list)
                               dir? objs)
            (param-declon-list-peel (cdr param-declon-list)
                                    dir? objs)))
    :measure (param-declon-list-count param-declon-list))

  (define param-declor-peel ((param-declor param-declorp)
                             (dir? direction-optionp)
                             (objs uid-ident-mapp))
    :returns (result param-declorp)
    (param-declor-case
     param-declor
     :nonabstract
     (c$::param-declor-nonabstract
       (declor-peel
         (param-declor-nonabstract->declor param-declor)
         dir? objs)
       (c$::param-declor-nonabstract->info param-declor))
     :abstract (param-declor-abstract
                 (absdeclor-peel
                   (c$::param-declor-abstract->declor param-declor)
                   dir? objs))
     :none (param-declor-fix param-declor)
     :ambig (param-declor-fix param-declor))
    :measure (param-declor-count param-declor))

  (define tyname-peel ((tyname tynamep)
                       (dir? direction-optionp)
                       (objs uid-ident-mapp))
    :returns (result tynamep)
    (tyname
     (spec/qual-list-peel (c$::tyname->specquals tyname)
                          dir? objs)
     (absdeclor-option-peel (c$::tyname->declor? tyname)
                            dir? objs)
     (tyname->info tyname))
    :measure (tyname-count tyname))

  (define struni-spec-peel ((struni-spec struni-specp)
                            (dir? direction-optionp)
                            (objs uid-ident-mapp))
    :returns (result struni-specp)
    (struni-spec (attrib-spec-list-peel
                   (c$::struni-spec->attribs struni-spec)
                   dir? objs)
                 (c$::struni-spec->name? struni-spec)
                 (struct-declon-list-peel
                   (c$::struni-spec->members struni-spec)
                   dir? objs))
    :measure (struni-spec-count struni-spec))

  (define struct-declon-peel
    ((struct-declon struct-declonp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result struct-declonp)
    (struct-declon-case
     struct-declon
     :member (c$::struct-declon-member
               (c$::struct-declon-member->extension struct-declon)
               (spec/qual-list-peel
                 (c$::struct-declon-member->specquals struct-declon)
                 dir? objs)
               (struct-declor-list-peel
                 (c$::struct-declon-member->declors struct-declon)
                 dir? objs)
               (attrib-spec-list-peel
                 (c$::struct-declon-member->attribs struct-declon)
                 dir? objs))
     :statassert
     (struct-declon-statassert
       (statassert-peel
         (c$::struct-declon-statassert->statassert struct-declon)
         dir? objs))
     :empty (struct-declon-fix struct-declon))
    :measure (struct-declon-count struct-declon))

  (define struct-declon-list-peel
    ((struct-declon-list struct-declon-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result struct-declon-listp)
    (if (endp struct-declon-list)
        nil
      (cons
        (struct-declon-peel (car struct-declon-list)
                            dir? objs)
        (struct-declon-list-peel (cdr struct-declon-list)
                                 dir? objs)))
    :measure (struct-declon-list-count struct-declon-list))

  (define struct-declor-peel ((struct-declor struct-declorp)
                              (dir? direction-optionp)
                              (objs uid-ident-mapp))
    :returns (result struct-declorp)
    (struct-declor (declor-option-peel
                     (c$::struct-declor->declor? struct-declor)
                     dir? objs)
                   (const-expr-option-peel
                     (c$::struct-declor->expr? struct-declor)
                     dir? objs))
    :measure (struct-declor-count struct-declor))

  (define struct-declor-list-peel
    ((struct-declor-list struct-declor-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result struct-declor-listp)
    (if (endp struct-declor-list)
        nil
      (cons
        (struct-declor-peel (car struct-declor-list)
                            dir? objs)
        (struct-declor-list-peel (cdr struct-declor-list)
                                 dir? objs)))
    :measure (struct-declor-list-count struct-declor-list))

  (define enum-spec-peel ((enum-spec enum-specp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result enum-specp)
    (enum-spec
     (c$::enum-spec->name? enum-spec)
     (enumer-list-peel (c$::enum-spec->enumers enum-spec)
                       dir? objs)
     (c$::enum-spec->final-comma enum-spec))
    :measure (enum-spec-count enum-spec))

  (define enumer-peel ((enumer enumerp)
                       (dir? direction-optionp)
                       (objs uid-ident-mapp))
    :returns (result enumerp)
    (enumer
     (c$::enumer->name enumer)
     (const-expr-option-peel (c$::enumer->value? enumer)
                             dir? objs))
    :measure (enumer-count enumer))

  (define enumer-list-peel ((enumer-list enumer-listp)
                            (dir? direction-optionp)
                            (objs uid-ident-mapp))
    :returns (result enumer-listp)
    (if (endp enumer-list)
        nil
      (cons (enumer-peel (car enumer-list)
                         dir? objs)
            (enumer-list-peel (cdr enumer-list)
                              dir? objs)))
    :measure (enumer-list-count enumer-list))

  (define statassert-peel ((statassert statassertp)
                           (dir? direction-optionp)
                           (objs uid-ident-mapp))
    :returns (result statassertp)
    (statassert
     (const-expr-peel (c$::statassert->test statassert)
                      dir? objs)
     (c$::statassert->message statassert))
    :measure (statassert-count statassert))

  (define attrib-peel ((attrib c$::attribp)
                       (dir? direction-optionp)
                       (objs uid-ident-mapp))
    :returns (result c$::attribp)
    (c$::attrib-case
     attrib
     :name (c$::attrib-fix attrib)
     :name-params
     (c$::attrib-name-params (c$::attrib-name-params->name attrib)
                             (expr-list-peel
                               (c$::attrib-name-params->params attrib)
                               dir? objs)))
    :measure (c$::attrib-count attrib))

  (define attrib-list-peel
    ((attrib-list c$::attrib-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result c$::attrib-listp)
    (if (endp attrib-list)
        nil
      (cons (attrib-peel (car attrib-list)
                         dir? objs)
            (attrib-list-peel (cdr attrib-list)
                              dir? objs)))
    :measure (c$::attrib-list-count attrib-list))

  (define attrib-spec-peel
    ((attrib-spec c$::attrib-specp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result c$::attrib-specp)
    (c$::attrib-spec (c$::attrib-spec->uscores attrib-spec)
                     (attrib-list-peel
                       (c$::attrib-spec->attribs attrib-spec)
                       dir? objs))
    :measure (c$::attrib-spec-count attrib-spec))

  (define attrib-spec-list-peel
    ((attrib-spec-list attrib-spec-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result attrib-spec-listp)
    (if (endp attrib-spec-list)
        nil
      (cons (attrib-spec-peel (car attrib-spec-list)
                              dir? objs)
            (attrib-spec-list-peel (cdr attrib-spec-list)
                                   dir? objs)))
    :measure (c$::attrib-spec-list-count attrib-spec-list))

  (define init-declor-peel ((init-declor init-declorp)
                            (dir? direction-optionp)
                            (objs uid-ident-mapp))
    :returns (result init-declorp)
    (init-declor
     (declor-peel (init-declor->declor init-declor)
                  dir? objs)
     (c$::init-declor->asm? init-declor)
     (attrib-spec-list-peel
       (c$::init-declor->attribs init-declor)
       dir? objs)
     (initer-option-peel (init-declor->initer? init-declor)
                         dir? objs)
     (c$::init-declor->info init-declor))
    :measure (init-declor-count init-declor))

  (define init-declor-list-peel
    ((init-declor-list init-declor-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result init-declor-listp)
    (if (endp init-declor-list)
        nil
      (cons (init-declor-peel (car init-declor-list)
                              dir? objs)
            (init-declor-list-peel (cdr init-declor-list)
                                   dir? objs)))
    :measure (init-declor-list-count init-declor-list))

  (define declon-peel ((declon declonp)
                       (dir? direction-optionp)
                       (objs uid-ident-mapp))
    :returns (result declonp)
    (declon-case
     declon
     :declon
     (declon-declon
       (declon-declon->extension declon)
       (decl-spec-list-peel (declon-declon->specs declon)
                            dir? objs)
       (init-declor-list-peel (declon-declon->declors declon)
                              dir? objs))
     :statassert
     (declon-statassert (statassert-peel
                          (c$::declon-statassert->statassert declon)
                          dir? objs)))
    :measure (declon-count declon))

  (define declon-list-peel ((declon-list declon-listp)
                            (dir? direction-optionp)
                            (objs uid-ident-mapp))
    :returns (result declon-listp)
    (if (endp declon-list)
        nil
      (cons (declon-peel (car declon-list)
                         dir? objs)
            (declon-list-peel (cdr declon-list)
                              dir? objs)))
    :measure (declon-list-count declon-list))

  (define label-peel ((label labelp)
                      (dir? direction-optionp)
                      (objs uid-ident-mapp))
    :returns (result labelp)
    (label-case
     label
     :name (c$::label-name (c$::label-name->name label)
                           (attrib-spec-list-peel
                             (c$::label-name->attribs label)
                             dir? objs))
     :casexpr
     (c$::label-casexpr
       (const-expr-peel (c$::label-casexpr->expr label)
                        dir? objs)
       (const-expr-option-peel
         (c$::label-casexpr->range? label)
         dir? objs))
     :default (label-fix label))
    :measure (label-count label))

  (define asm-output-peel ((asm-output c$::asm-outputp)
                           (dir? direction-optionp)
                           (objs uid-ident-mapp))
    :returns (result c$::asm-outputp)
    (c$::asm-output
     (c$::asm-output->name? asm-output)
     (c$::asm-output->constraint asm-output)
     (expr-peel (c$::asm-output->lvalue asm-output)
                dir? objs))
    :measure (c$::asm-output-count asm-output))

  (define asm-output-list-peel
    ((asm-output-list c$::asm-output-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result c$::asm-output-listp)
    (if (endp asm-output-list)
        nil
      (cons (asm-output-peel (car asm-output-list)
                             dir? objs)
            (asm-output-list-peel (cdr asm-output-list)
                                  dir? objs)))
    :measure (c$::asm-output-list-count asm-output-list))

  (define asm-input-peel ((asm-input c$::asm-inputp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result c$::asm-inputp)
    (c$::asm-input
     (c$::asm-input->name? asm-input)
     (c$::asm-input->constraint asm-input)
     (expr-peel (c$::asm-input->rvalue asm-input)
                dir? objs))
    :measure (c$::asm-input-count asm-input))

  (define asm-input-list-peel
    ((asm-input-list c$::asm-input-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result c$::asm-input-listp)
    (if (endp asm-input-list)
        nil
      (cons (asm-input-peel (car asm-input-list)
                            dir? objs)
            (asm-input-list-peel (cdr asm-input-list)
                                 dir? objs)))
    :measure (c$::asm-input-list-count asm-input-list))

  (define asm-stmt-peel ((asm-stmt c$::asm-stmtp)
                         (dir? direction-optionp)
                         (objs uid-ident-mapp))
    :returns (result c$::asm-stmtp)
    (c$::asm-stmt
     (c$::asm-stmt->uscores asm-stmt)
     (c$::asm-stmt->quals asm-stmt)
     (c$::asm-stmt->template asm-stmt)
     (c$::asm-stmt->num-colons asm-stmt)
     (asm-output-list-peel
       (c$::asm-stmt->outputs asm-stmt)
       dir? objs)
     (asm-input-list-peel (c$::asm-stmt->inputs asm-stmt)
                          dir? objs)
     (c$::asm-stmt->clobbers asm-stmt)
     (c$::asm-stmt->labels asm-stmt))
    :measure (c$::asm-stmt-count asm-stmt))

  (define stmt-peel ((stmt stmtp)
                     (dir? direction-optionp)
                     (objs uid-ident-mapp))
    :returns (result stmtp)
    (stmt-case
     stmt
     :labeled
     (c$::stmt-labeled
       (label-peel (c$::stmt-labeled->label stmt)
                   dir? objs)
       (stmt-peel (c$::stmt-labeled->stmt stmt)
                  dir? objs))
     :compound
     (stmt-compound
       (comp-stmt-peel (stmt-compound->stmt stmt)
                       dir? objs))
     :expr
     (stmt-expr
       (expr-option-peel (c$::stmt-expr->expr? stmt)
                         dir? objs)
       (c$::stmt-expr->info stmt))
     :null-attrib
     (stmt-null-attrib (attrib-spec-peel
                         (c$::stmt-null-attrib->attrib stmt)
                         dir? objs))
     :if (stmt-if (expr-peel (c$::stmt-if->test stmt)
                             dir? objs)
                  (stmt-peel (c$::stmt-if->then stmt)
                             dir? objs))
     :ifelse
     (stmt-ifelse (expr-peel (c$::stmt-ifelse->test stmt)
                             dir? objs)
                  (stmt-peel (c$::stmt-ifelse->then stmt)
                             dir? objs)
                  (stmt-peel (c$::stmt-ifelse->else stmt)
                             dir? objs))
     :switch
     (c$::stmt-switch
       (expr-peel (c$::stmt-switch->target stmt)
                  dir? objs)
       (stmt-peel (c$::stmt-switch->body stmt)
                  dir? objs))
     :while
     (stmt-while (expr-peel (c$::stmt-while->test stmt)
                            dir? objs)
                 (stmt-peel (c$::stmt-while->body stmt)
                            dir? objs))
     :dowhile
     (stmt-dowhile
       (stmt-peel (c$::stmt-dowhile->body stmt)
                  dir? objs)
       (expr-peel (c$::stmt-dowhile->test stmt)
                  dir? objs))
     :for-expr
     (c$::stmt-for-expr
       (expr-option-peel (c$::stmt-for-expr->init stmt)
                         dir? objs)
       (expr-option-peel (c$::stmt-for-expr->test stmt)
                         dir? objs)
       (expr-option-peel (c$::stmt-for-expr->next stmt)
                         dir? objs)
       (stmt-peel (c$::stmt-for-expr->body stmt)
                  dir? objs))
     :for-declon
     (c$::stmt-for-declon
       (declon-peel (c$::stmt-for-declon->init stmt)
                    dir? objs)
       (expr-option-peel (c$::stmt-for-declon->test stmt)
                         dir? objs)
       (expr-option-peel (c$::stmt-for-declon->next stmt)
                         dir? objs)
       (stmt-peel (c$::stmt-for-declon->body stmt)
                  dir? objs))
     :goto (stmt-fix stmt)
     :gotoe
     (stmt-gotoe (expr-peel (c$::stmt-gotoe->label stmt)
                            dir? objs))
     :continue (stmt-fix stmt)
     :break (stmt-fix stmt)
     :return
     (stmt-return
       (expr-option-peel (c$::stmt-return->expr? stmt)
                         dir? objs)
       (c$::stmt-return->info stmt))
     :return-attrib
     (stmt-return-attrib
       (attrib-spec-peel
         (c$::stmt-return-attrib->attrib stmt)
         dir? objs)
       (expr-peel (c$::stmt-return-attrib->expr stmt)
                  dir? objs))
     :asm (c$::stmt-asm
            (asm-stmt-peel (c$::stmt-asm->stmt stmt)
                           dir? objs))
     :for-ambig (stmt-fix stmt))
    :measure (stmt-count stmt))

  (define comp-stmt-peel ((comp-stmt comp-stmtp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result comp-stmtp)
    (comp-stmt
     (comp-stmt->labels comp-stmt)
     (block-item-list-peel (comp-stmt->items comp-stmt)
                           dir? objs))
    :measure (comp-stmt-count comp-stmt))

  (define block-item-peel ((block-item block-itemp)
                           (dir? direction-optionp)
                           (objs uid-ident-mapp))
    :returns (result block-itemp)
    (block-item-case
     block-item
     :declon
     (block-item-declon (declon-peel
                          (c$::block-item-declon->declon block-item)
                          dir? objs)
                        (c$::block-item-declon->info block-item))
     :stmt
     (block-item-stmt
       (stmt-peel (c$::block-item-stmt->stmt block-item)
                  dir? objs)
       (c$::block-item-stmt->info block-item))
     :ambig (block-item-fix block-item))
    :measure (block-item-count block-item))

  (define block-item-list-peel
    ((block-item-list block-item-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result block-item-listp)
    (if (endp block-item-list)
        nil
      (cons (block-item-peel (car block-item-list)
                             dir? objs)
            (block-item-list-peel (cdr block-item-list)
                                  dir? objs)))
    :measure (block-item-list-count block-item-list))

  :verify-guards :after-returns
  ;; :flag-local nil
  )
|#
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; TODO: return type?

;; It may be pausing to think about where an xform step can return split
;; results.
;; For instance, it is definitely possible for declarators, statements, address
;; operator.
;; - W.r.t the address operator, perhaps we can consider it an error if this
;;   appears in undirected context.
;;   - And perhaps, this can be the norm. Perhaps it is a small number of
;;     things which can actually return multiple.
;; - Assignment expression can split
;; And it is definitely impossible for +.
;;
;; What are the cases where we can split?

;; Start with very few cases that allow splits on sub-ASTs. Can expand over
;; time.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defines exprs/decls/stmts-peel
  (define expr-peel ((expr exprp)
                     (dir? direction-optionp)
                     (objs uid-ident-mapp))
    :guard (expr-annop expr)
    :returns (mv (er? maybe-msgp)
                 (splitp booleanp)
                 (expr1 exprp)
                 (expr2? expr-optionp)
                 (objs$ uid-ident-mapp))
    (b* ((expr (expr-fix expr))
         (objs (uid-ident-map-fix objs))
         ((reterr) (expr-fix expr) nil objs))
      (expr-case
        expr
        :ident (b* (((when (and dir? (direction-case dir? :left)))
                     (retok nil expr (irr-expr) objs))
                    ((var-info info) expr.info)
                    (ident? (omap::assoc info.uid objs))
                    ((unless ident?)
                     (retok expr nil objs))
                    (expr-right (make-expr-ident :ident ident? :info nil)))
                 (if dir? ;; dir? is :right
                     (retok expr-right nil objs)
                   (retok expr expr-right objs)
        :const (retok expr nil objs)
        :string (retok expr nil objs)
        :paren (b* (((erp expr1 expr2? objs)
                     (expr-peel expr.inner dir? objs)))
                 (retok (expr-paren expr1)
                        (if expr2? (expr-paren expr2) nil)
                        objs))
        :gensel (b* (((erp control1 control2? objs)
                      (expr-peel expr.control dir? objs))
                     ((erp assocs1 assocs2? objs)
                      (expr-peel expr.control dir? objs))
                     ((when (or control2? assocs2?))
                      ;; TODO: think about whether this can be supported.
                      (retmsg$ "Splits are not supported in ~
                                generic selection expressions.")))
                  (retok (make-expr-gensel :control control1 :assocs assocs1)
                         nil
                         objs))
        :arrsub (b* (((erp arg1$1 arg1$2? objs)
                      (expr-peel expr.arg1 dir? objs))
                     ((when arg1$2?)
                      ;; TODO: support this once array types derived from the
                      ;;   target struct type is supported.
                      (retmsg$ "Splits are not supported in ~
                                array subscripting expressions."))
                     ((erp arg2$1 arg2$2? objs)
                      (expr-peel expr.arg2 dir? objs))
                     ((when arg2$2?)
                      (retmsg$ "Splits are not supported in ~
                                array subscripts.")))
                  (retok (change-expr-arrsub expr :arg1 arg1$1 :arg2 arg2$1)
                         nil
                         objs))
        :funcall (b* (((erp fun1 fun2? objs)
                       (expr-peel expr.fun dir? objs))
                      ((when fun2?)
                       (retmsg$ "Splits are not supported in ~
                                 function expressions."))
                      ((erp args1 arg2$2? objs)
                       (expr-peel expr.arg2 dir? objs))
                      ((when arg2$2?)
                       (retmsg$ "Splits are not supported in ~
                                array subscripts.")))
                   (retok (change-expr-arrsub expr :arg1 arg1$1 :arg2 arg2$1)
                          nil
                          objs))
        (c$::expr-funcall
          (expr-peel (c$::expr-funcall->fun expr)
                     dir? objs)
          (expr-list-peel (c$::expr-funcall->args expr)
                          dir? objs)
          (c$::expr-funcall->info expr))
        :member (c$::expr-member
                  (expr-peel (c$::expr-member->arg expr)
                             dir? objs)
                  (c$::expr-member->name expr))
        :memberp (c$::expr-memberp
                   (expr-peel (c$::expr-memberp->arg expr)
                              dir? objs)
                   (c$::expr-memberp->name expr))
        :complit
        (c$::expr-complit
          (tyname-peel (c$::expr-complit->type expr)
                       dir? objs)
          (desiniter-list-peel (c$::expr-complit->elems expr)
                               dir? objs)
          (c$::expr-complit->final-comma expr))
        :unary
        (expr-unary (c$::expr-unary->op expr)
                    (expr-peel (c$::expr-unary->arg expr)
                               dir? objs)
                    (c$::expr-unary->info expr))
        :label-addr (expr-fix expr)
        :sizeof
        (expr-sizeof
          (tyname-peel (c$::expr-sizeof->type expr)
                       dir? objs))
        :alignof
        (expr-alignof
          (tyname-peel (c$::expr-alignof->type expr)
                       dir? objs)
          (c$::expr-alignof->uscores expr))
        :cast
        (expr-cast (tyname-peel (c$::expr-cast->type expr)
                                dir? objs)
                   (expr-peel (c$::expr-cast->arg expr)
                              dir? objs))
        :binary
        (expr-binary (expr-binary->op expr)
                     (expr-peel (expr-binary->arg1 expr)
                                dir? objs)
                     (expr-peel (expr-binary->arg2 expr)
                                dir? objs)
                     (c$::expr-binary->info expr))
        :cond
        (expr-cond
          (expr-peel (c$::expr-cond->test expr)
                     dir? objs)
          (expr-option-peel (c$::expr-cond->then expr)
                            dir? objs)
          (expr-peel (c$::expr-cond->else expr)
                     dir? objs))
        :comma (c$::expr-comma
                 (expr-peel (c$::expr-comma->first expr)
                            dir? objs)
                 (expr-peel (c$::expr-comma->next expr)
                            dir? objs))
        :stmt
        (expr-stmt (comp-stmt-peel (c$::expr-stmt->stmt expr)
                                   dir? objs))
        :tycompat
        (c$::expr-tycompat
          (tyname-peel (c$::expr-tycompat->type1 expr)
                       dir? objs)
          (tyname-peel (c$::expr-tycompat->type2 expr)
                       dir? objs))
        :offsetof
        (c$::expr-offsetof
          (tyname-peel (c$::expr-offsetof->type expr)
                       dir? objs)
          (member-designor-peel
            (c$::expr-offsetof->member expr)
            dir? objs))
        :va-arg
        (c$::expr-va-arg
          (expr-peel (c$::expr-va-arg->list expr)
                     dir? objs)
          (tyname-peel (c$::expr-va-arg->type expr)
                       dir? objs))
        :extension
        (expr-extension
          (expr-peel (c$::expr-extension->expr expr)
                     dir? objs))
        :sizeof-ambig (expr-fix expr)
        :alignof-ambig (expr-fix expr)
        :cast/call-ambig (expr-fix expr)
        :cast/mul-ambig (expr-fix expr)
        :cast/add-ambig (expr-fix expr)
        :cast/sub-ambig (expr-fix expr)
        :cast/and-ambig (expr-fix expr)
        :cast/logand-ambig (expr-fix expr)))
    :measure (expr-count expr))

  (define expr-list-peel ((expr-list expr-listp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result expr-listp)
    (if (endp expr-list)
        nil
      (cons (expr-peel (car expr-list)
                       dir? objs)
            (expr-list-peel (cdr expr-list)
                            dir? objs)))
    :measure (expr-list-count expr-list))


  (define expr-option-peel ((expr-option expr-optionp)
                            (dir? direction-optionp)
                            (objs uid-ident-mapp))
    :returns (result expr-optionp)
    (expr-option-case
     expr-option
     :some
     (expr-fix
       (expr-peel (expr-option-some->val expr-option)
                  dir? objs))
     :none nil)
    :measure (expr-option-count expr-option))

  (define const-expr-peel ((const-expr const-exprp)
                           (dir? direction-optionp)
                           (objs uid-ident-mapp))
    :returns (result const-exprp)
    (const-expr (expr-peel (const-expr->expr const-expr)
                           dir? objs))
    :measure (const-expr-count const-expr))

  (define const-expr-option-peel
    ((const-expr-option const-expr-optionp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result const-expr-optionp)
    (const-expr-option-case
     const-expr-option
     :some (c$::const-expr-fix
             (const-expr-peel
               (c$::const-expr-option-some->val const-expr-option)
               dir? objs))
     :none nil)
    :measure (const-expr-option-count const-expr-option))

  (define genassoc-peel ((genassoc genassocp)
                         (dir? direction-optionp)
                         (objs uid-ident-mapp))
    :returns (result genassocp)
    (genassoc-case
     genassoc
     :type
     (c$::genassoc-type
       (tyname-peel (c$::genassoc-type->type genassoc)
                    dir? objs)
       (expr-peel (c$::genassoc-type->expr genassoc)
                  dir? objs))
     :default
     (genassoc-default
       (expr-peel (c$::genassoc-default->expr genassoc)
                  dir? objs)))
    :measure (genassoc-count genassoc))

  (define genassoc-list-peel
    ((genassoc-list genassoc-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result genassoc-listp)
    (if (endp genassoc-list)
        nil
      (cons (genassoc-peel (car genassoc-list)
                           dir? objs)
            (genassoc-list-peel (cdr genassoc-list)
                                dir? objs)))
    :measure (genassoc-list-count genassoc-list))

  (define member-designor-peel
    ((member-designor member-designorp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result member-designorp)
    (member-designor-case
     member-designor
     :ident (member-designor-fix member-designor)
     :dot (c$::member-designor-dot
            (member-designor-peel
              (c$::member-designor-dot->member member-designor)
              dir? objs)
            (c$::member-designor-dot->name member-designor))
     :sub (c$::member-designor-sub
            (member-designor-peel
              (c$::member-designor-sub->member member-designor)
              dir? objs)
            (expr-peel
              (c$::member-designor-sub->index member-designor)
              dir? objs)))
    :measure (member-designor-count member-designor))

  (define type-spec-peel ((type-spec type-specp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result type-specp)
    (type-spec-case
     type-spec
     :void (type-spec-fix type-spec)
     :char (type-spec-fix type-spec)
     :short (type-spec-fix type-spec)
     :int (type-spec-fix type-spec)
     :long (type-spec-fix type-spec)
     :float (type-spec-fix type-spec)
     :double (type-spec-fix type-spec)
     :signed (type-spec-fix type-spec)
     :unsigned (type-spec-fix type-spec)
     :bool (type-spec-fix type-spec)
     :complex (type-spec-fix type-spec)
     :atomic
     (type-spec-atomic
       (tyname-peel (c$::type-spec-atomic->type type-spec)
                    dir? objs))
     :struct (type-spec-struct (struni-spec-peel
                                 (c$::type-spec-struct->spec type-spec)
                                 dir? objs))
     :union (type-spec-union (struni-spec-peel
                               (c$::type-spec-union->spec type-spec)
                               dir? objs))
     :enum
     (type-spec-enum
       (enum-spec-peel (c$::type-spec-enum->spec type-spec)
                       dir? objs))
     :typedef (type-spec-fix type-spec)
     :int128 (type-spec-fix type-spec)
     :locase-float80 (type-spec-fix type-spec)
     :locase-float128 (type-spec-fix type-spec)
     :float16 (type-spec-fix type-spec)
     :float16x (type-spec-fix type-spec)
     :float32 (type-spec-fix type-spec)
     :float32x (type-spec-fix type-spec)
     :float64 (type-spec-fix type-spec)
     :float64x (type-spec-fix type-spec)
     :float128 (type-spec-fix type-spec)
     :float128x (type-spec-fix type-spec)
     :builtin-va-list (type-spec-fix type-spec)
     :struct-empty
     (c$::type-spec-struct-empty
       (attrib-spec-list-peel
         (c$::type-spec-struct-empty->attribs type-spec)
         dir? objs)
       (c$::type-spec-struct-empty->name? type-spec))
     :typeof-expr (c$::type-spec-typeof-expr
                    (expr-peel
                      (c$::type-spec-typeof-expr->expr type-spec)
                      dir? objs)
                    (c$::type-spec-typeof-expr->uscores type-spec))
     :typeof-type (c$::type-spec-typeof-type
                    (tyname-peel
                      (c$::type-spec-typeof-type->type type-spec)
                      dir? objs)
                    (c$::type-spec-typeof-type->uscores type-spec))
     :auto-type (type-spec-fix type-spec)
     :typeof-ambig (type-spec-fix type-spec))
    :measure (type-spec-count type-spec))

  (define spec/qual-peel ((spec/qual spec/qual-p)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result spec/qual-p)
    (spec/qual-case
     spec/qual
     :typespec
     (spec/qual-typespec (type-spec-peel
                           (c$::spec/qual-typespec->spec spec/qual)
                           dir? objs))
     :typequal (spec/qual-fix spec/qual)
     :align (spec/qual-align (align-spec-peel
                               (c$::spec/qual-align->spec spec/qual)
                               dir? objs))
     :attrib (spec/qual-attrib (attrib-spec-peel
                                 (c$::spec/qual-attrib->spec spec/qual)
                                 dir? objs)))
    :measure (spec/qual-count spec/qual))

  (define spec/qual-list-peel
    ((specqual-list spec/qual-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result spec/qual-listp)
    (if (endp specqual-list)
        nil
      (cons (spec/qual-peel (car specqual-list)
                            dir? objs)
            (spec/qual-list-peel (cdr specqual-list)
                                 dir? objs)))
    :measure (spec/qual-list-count specqual-list))

  (define align-spec-peel ((align-spec align-specp)
                           (dir? direction-optionp)
                           (objs uid-ident-mapp))
    :returns (result align-specp)
    (align-spec-case
     align-spec
     :alignas-type
     (align-spec-alignas-type
       (tyname-peel
         (c$::align-spec-alignas-type->type align-spec)
         dir? objs))
     :alignas-expr
     (align-spec-alignas-expr
       (const-expr-peel
         (c$::align-spec-alignas-expr->expr align-spec)
         dir? objs))
     :alignas-ambig (align-spec-fix align-spec))
    :measure (align-spec-count align-spec))

  (define decl-spec-peel ((decl-spec decl-specp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result decl-specp)
    (decl-spec-case
     decl-spec
     :stoclass (decl-spec-fix decl-spec)
     :typespec
     (decl-spec-typespec (type-spec-peel
                           (c$::decl-spec-typespec->spec decl-spec)
                           dir? objs))
     :typequal (decl-spec-fix decl-spec)
     :function (decl-spec-fix decl-spec)
     :align (decl-spec-align (align-spec-peel
                               (c$::decl-spec-align->spec decl-spec)
                               dir? objs))
     :attrib (decl-spec-attrib (attrib-spec-peel
                                 (c$::decl-spec-attrib->spec decl-spec)
                                 dir? objs))
     :stdcall (decl-spec-fix decl-spec)
     :declspec (decl-spec-fix decl-spec))
    :measure (decl-spec-count decl-spec))

  (define decl-spec-list-peel
    ((decl-spec-list decl-spec-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result decl-spec-listp)
    (if (endp decl-spec-list)
        nil
      (cons (decl-spec-peel (car decl-spec-list)
                            dir? objs)
            (decl-spec-list-peel (cdr decl-spec-list)
                                 dir? objs)))
    :measure (decl-spec-list-count decl-spec-list))

  (define typequal/attribspec-peel
    ((typequal/attribspec c$::typequal/attribspec-p)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result c$::typequal/attribspec-p)
    (c$::typequal/attribspec-case
     typequal/attribspec
     :type (c$::typequal/attribspec-fix typequal/attribspec)
     :attrib
     (c$::typequal/attribspec-attrib
       (attrib-spec-peel
         (c$::typequal/attribspec-attrib->spec typequal/attribspec)
         dir? objs)))
    :measure (c$::typequal/attribspec-count typequal/attribspec))

  (define typequal/attribspec-list-peel
    ((typequal/attribspec-list c$::typequal/attribspec-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result c$::typequal/attribspec-listp)
    (if (endp typequal/attribspec-list)
        nil
      (cons (typequal/attribspec-peel
              (car typequal/attribspec-list)
              dir? objs)
            (typequal/attribspec-list-peel
              (cdr typequal/attribspec-list)
              dir? objs)))
    :measure (c$::typequal/attribspec-list-count typequal/attribspec-list))

  (define typequal/attribspec-list-list-peel
    ((typequal/attribspec-list-list typequal/attribspec-list-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result typequal/attribspec-list-listp)
    (if (endp typequal/attribspec-list-list)
        nil
      (cons (typequal/attribspec-list-peel
              (car typequal/attribspec-list-list)
              dir? objs)
            (typequal/attribspec-list-list-peel
              (cdr typequal/attribspec-list-list)
              dir? objs)))
    :measure (c$::typequal/attribspec-list-list-count
              typequal/attribspec-list-list))

  (define initer-peel ((initer initerp)
                       (dir? direction-optionp)
                       (objs uid-ident-mapp))
    :returns (result initerp)
    (initer-case
     initer
     :single
     (initer-single
       (expr-peel (c$::initer-single->expr initer)
                  dir? objs))
     :list
     (c$::initer-list
       (desiniter-list-peel (c$::initer-list->elems initer)
                            dir? objs)
       (c$::initer-list->final-comma initer)))
    :measure (initer-count initer))

  (define initer-option-peel
    ((initer-option initer-optionp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result initer-optionp)
    (initer-option-case
     initer-option
     :some (initer-fix (initer-peel
                         (c$::initer-option-some->val initer-option)
                         dir? objs))
     :none nil)
    :measure (initer-option-count initer-option))

  (define desiniter-peel ((desiniter desiniterp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result desiniterp)
    (desiniter
     (designor-list-peel (c$::desiniter->designors desiniter)
                         dir? objs)
     (initer-peel (c$::desiniter->initer desiniter)
                  dir? objs))
    :measure (desiniter-count desiniter))

  (define desiniter-list-peel
    ((desiniter-list desiniter-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result desiniter-listp)
    (if (endp desiniter-list)
        nil
      (cons (desiniter-peel (car desiniter-list)
                            dir? objs)
            (desiniter-list-peel (cdr desiniter-list)
                                 dir? objs)))
    :measure (desiniter-list-count desiniter-list))

  (define designor-peel ((designor designorp)
                         (dir? direction-optionp)
                         (objs uid-ident-mapp))
    :returns (result designorp)
    (designor-case
     designor
     :sub
     (c$::designor-sub
       (const-expr-peel (c$::designor-sub->index designor)
                        dir? objs)
       (const-expr-option-peel
         (c$::designor-sub->range? designor)
         dir? objs))
     :dot (designor-fix designor))
    :measure (designor-count designor))

  (define designor-list-peel
    ((designor-list designor-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result designor-listp)
    (if (endp designor-list)
        nil
      (cons (designor-peel (car designor-list)
                           dir? objs)
            (designor-list-peel (cdr designor-list)
                                dir? objs)))
    :measure (designor-list-count designor-list))

  (define declor-peel ((declor declorp)
                       (dir? direction-optionp)
                       (objs uid-ident-mapp))
    :returns (result declorp)
    (declor (typequal/attribspec-list-list-peel
              (c$::declor->pointers declor)
              dir? objs)
            (dirdeclor-peel (declor->direct declor)
                            dir? objs))
    :measure (declor-count declor))

  (define declor-option-peel
    ((declor-option declor-optionp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result declor-optionp)
    (declor-option-case
     declor-option
     :some (declor-fix (declor-peel
                         (c$::declor-option-some->val declor-option)
                         dir? objs))
     :none nil)
    :measure (declor-option-count declor-option))

  (define dirdeclor-peel ((dirdeclor dirdeclorp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result dirdeclorp)
    (dirdeclor-case
     dirdeclor
     :ident (dirdeclor-fix dirdeclor)
     :paren
     (dirdeclor-paren
       (declor-peel (c$::dirdeclor-paren->inner dirdeclor)
                    dir? objs))
     :array
     (c$::dirdeclor-array
       (dirdeclor-peel (c$::dirdeclor-array->declor dirdeclor)
                       dir? objs)
       (typequal/attribspec-list-peel
         (c$::dirdeclor-array->qualspecs dirdeclor)
         dir? objs)
       (expr-option-peel (c$::dirdeclor-array->size? dirdeclor)
                         dir? objs))
     :array-static1
     (c$::dirdeclor-array-static1
       (dirdeclor-peel
         (c$::dirdeclor-array-static1->declor dirdeclor)
         dir? objs)
       (typequal/attribspec-list-peel
         (c$::dirdeclor-array-static1->qualspecs dirdeclor)
         dir? objs)
       (expr-peel (c$::dirdeclor-array-static1->size dirdeclor)
                  dir? objs))
     :array-static2
     (c$::dirdeclor-array-static2
       (dirdeclor-peel
         (c$::dirdeclor-array-static2->declor dirdeclor)
         dir? objs)
       (typequal/attribspec-list-peel
         (c$::dirdeclor-array-static2->qualspecs dirdeclor)
         dir? objs)
       (expr-peel (c$::dirdeclor-array-static2->size dirdeclor)
                  dir? objs))
     :array-star (c$::dirdeclor-array-star
                   (dirdeclor-peel
                     (c$::dirdeclor-array-star->declor dirdeclor)
                     dir? objs)
                   (typequal/attribspec-list-peel
                     (c$::dirdeclor-array-star->qualspecs dirdeclor)
                     dir? objs))
     :function-params
     (c$::dirdeclor-function-params
       (dirdeclor-peel
         (dirdeclor-function-params->declor dirdeclor)
         dir? objs)
       (param-declon-list-peel
         (dirdeclor-function-params->params dirdeclor)
         dir? objs)
       (c$::dirdeclor-function-params->ellipsis dirdeclor))
     :function-names
     (c$::dirdeclor-function-names
       (dirdeclor-peel
         (c$::dirdeclor-function-names->declor dirdeclor)
         dir? objs)
       (dirdeclor-function-names->names dirdeclor)))
    :measure (dirdeclor-count dirdeclor))

  (define absdeclor-peel ((absdeclor absdeclorp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result absdeclorp)
    (absdeclor (typequal/attribspec-list-list-peel
                 (c$::absdeclor->pointers absdeclor)
                 dir? objs)
               (dirabsdeclor-option-peel
                 (c$::absdeclor->direct? absdeclor)
                 dir? objs))
    :measure (absdeclor-count absdeclor))

  (define absdeclor-option-peel
    ((absdeclor-option absdeclor-optionp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result absdeclor-optionp)
    (absdeclor-option-case
     absdeclor-option
     :some
     (absdeclor-fix (absdeclor-peel
                      (c$::absdeclor-option-some->val absdeclor-option)
                      dir? objs))
     :none nil)
    :measure (absdeclor-option-count absdeclor-option))

  (define dirabsdeclor-peel ((dirabsdeclor dirabsdeclorp)
                             (dir? direction-optionp)
                             (objs uid-ident-mapp))
    :returns (result dirabsdeclorp)
    (dirabsdeclor-case
     dirabsdeclor
     :dummy-base (dirabsdeclor-fix dirabsdeclor)
     :paren
     (dirabsdeclor-paren (absdeclor-peel
                           (c$::dirabsdeclor-paren->inner dirabsdeclor)
                           dir? objs))
     :array (c$::dirabsdeclor-array
              (dirabsdeclor-option-peel
                (c$::dirabsdeclor-array->declor? dirabsdeclor)
                dir? objs)
              (typequal/attribspec-list-peel
                (c$::dirabsdeclor-array->qualspecs dirabsdeclor)
                dir? objs)
              (expr-option-peel
                (c$::dirabsdeclor-array->size? dirabsdeclor)
                dir? objs))
     :array-static1
     (c$::dirabsdeclor-array-static1
       (dirabsdeclor-option-peel
         (c$::dirabsdeclor-array-static1->declor? dirabsdeclor)
         dir? objs)
       (typequal/attribspec-list-peel
         (c$::dirabsdeclor-array-static1->qualspecs dirabsdeclor)
         dir? objs)
       (expr-peel
         (c$::dirabsdeclor-array-static1->size dirabsdeclor)
         dir? objs))
     :array-static2
     (c$::dirabsdeclor-array-static2
       (dirabsdeclor-option-peel
         (c$::dirabsdeclor-array-static2->declor? dirabsdeclor)
         dir? objs)
       (typequal/attribspec-list-peel
         (c$::dirabsdeclor-array-static2->qualspecs dirabsdeclor)
         dir? objs)
       (expr-peel
         (c$::dirabsdeclor-array-static2->size dirabsdeclor)
         dir? objs))
     :array-star
     (dirabsdeclor-array-star
       (dirabsdeclor-option-peel
         (c$::dirabsdeclor-array-star->declor? dirabsdeclor)
         dir? objs))
     :function (c$::dirabsdeclor-function
                 (dirabsdeclor-option-peel
                   (c$::dirabsdeclor-function->declor? dirabsdeclor)
                   dir? objs)
                 (param-declon-list-peel
                   (c$::dirabsdeclor-function->params dirabsdeclor)
                   dir? objs)
                 (c$::dirabsdeclor-function->ellipsis dirabsdeclor)))
    :measure (dirabsdeclor-count dirabsdeclor))

  (define dirabsdeclor-option-peel
    ((dirabsdeclor-option dirabsdeclor-optionp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result dirabsdeclor-optionp)
    (dirabsdeclor-option-case
     dirabsdeclor-option
     :some
     (dirabsdeclor-fix
       (dirabsdeclor-peel
         (c$::dirabsdeclor-option-some->val dirabsdeclor-option)
         dir? objs))
     :none nil)
    :measure (dirabsdeclor-option-count dirabsdeclor-option))

  (define param-declon-peel ((param-declon param-declonp)
                             (dir? direction-optionp)
                             (objs uid-ident-mapp))
    :returns (result param-declonp)
    (param-declon (decl-spec-list-peel
                    (c$::param-declon->specs param-declon)
                    dir? objs)
                  (param-declor-peel
                    (c$::param-declon->declor param-declon)
                    dir? objs)
                  (attrib-spec-list-peel
                    (c$::param-declon->attribs param-declon)
                    dir? objs))
    :measure (param-declon-count param-declon))

  (define param-declon-list-peel
    ((param-declon-list param-declon-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result param-declon-listp)
    (if (endp param-declon-list)
        nil
      (cons (param-declon-peel (car param-declon-list)
                               dir? objs)
            (param-declon-list-peel (cdr param-declon-list)
                                    dir? objs)))
    :measure (param-declon-list-count param-declon-list))

  (define param-declor-peel ((param-declor param-declorp)
                             (dir? direction-optionp)
                             (objs uid-ident-mapp))
    :returns (result param-declorp)
    (param-declor-case
     param-declor
     :nonabstract
     (c$::param-declor-nonabstract
       (declor-peel
         (param-declor-nonabstract->declor param-declor)
         dir? objs)
       (c$::param-declor-nonabstract->info param-declor))
     :abstract (param-declor-abstract
                 (absdeclor-peel
                   (c$::param-declor-abstract->declor param-declor)
                   dir? objs))
     :none (param-declor-fix param-declor)
     :ambig (param-declor-fix param-declor))
    :measure (param-declor-count param-declor))

  (define tyname-peel ((tyname tynamep)
                       (dir? direction-optionp)
                       (objs uid-ident-mapp))
    :returns (result tynamep)
    (tyname
     (spec/qual-list-peel (c$::tyname->specquals tyname)
                          dir? objs)
     (absdeclor-option-peel (c$::tyname->declor? tyname)
                            dir? objs)
     (tyname->info tyname))
    :measure (tyname-count tyname))

  (define struni-spec-peel ((struni-spec struni-specp)
                            (dir? direction-optionp)
                            (objs uid-ident-mapp))
    :returns (result struni-specp)
    (struni-spec (attrib-spec-list-peel
                   (c$::struni-spec->attribs struni-spec)
                   dir? objs)
                 (c$::struni-spec->name? struni-spec)
                 (struct-declon-list-peel
                   (c$::struni-spec->members struni-spec)
                   dir? objs))
    :measure (struni-spec-count struni-spec))

  (define struct-declon-peel
    ((struct-declon struct-declonp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result struct-declonp)
    (struct-declon-case
     struct-declon
     :member (c$::struct-declon-member
               (c$::struct-declon-member->extension struct-declon)
               (spec/qual-list-peel
                 (c$::struct-declon-member->specquals struct-declon)
                 dir? objs)
               (struct-declor-list-peel
                 (c$::struct-declon-member->declors struct-declon)
                 dir? objs)
               (attrib-spec-list-peel
                 (c$::struct-declon-member->attribs struct-declon)
                 dir? objs))
     :statassert
     (struct-declon-statassert
       (statassert-peel
         (c$::struct-declon-statassert->statassert struct-declon)
         dir? objs))
     :empty (struct-declon-fix struct-declon))
    :measure (struct-declon-count struct-declon))

  (define struct-declon-list-peel
    ((struct-declon-list struct-declon-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result struct-declon-listp)
    (if (endp struct-declon-list)
        nil
      (cons
        (struct-declon-peel (car struct-declon-list)
                            dir? objs)
        (struct-declon-list-peel (cdr struct-declon-list)
                                 dir? objs)))
    :measure (struct-declon-list-count struct-declon-list))

  (define struct-declor-peel ((struct-declor struct-declorp)
                              (dir? direction-optionp)
                              (objs uid-ident-mapp))
    :returns (result struct-declorp)
    (struct-declor (declor-option-peel
                     (c$::struct-declor->declor? struct-declor)
                     dir? objs)
                   (const-expr-option-peel
                     (c$::struct-declor->expr? struct-declor)
                     dir? objs))
    :measure (struct-declor-count struct-declor))

  (define struct-declor-list-peel
    ((struct-declor-list struct-declor-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result struct-declor-listp)
    (if (endp struct-declor-list)
        nil
      (cons
        (struct-declor-peel (car struct-declor-list)
                            dir? objs)
        (struct-declor-list-peel (cdr struct-declor-list)
                                 dir? objs)))
    :measure (struct-declor-list-count struct-declor-list))

  (define enum-spec-peel ((enum-spec enum-specp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result enum-specp)
    (enum-spec
     (c$::enum-spec->name? enum-spec)
     (enumer-list-peel (c$::enum-spec->enumers enum-spec)
                       dir? objs)
     (c$::enum-spec->final-comma enum-spec))
    :measure (enum-spec-count enum-spec))

  (define enumer-peel ((enumer enumerp)
                       (dir? direction-optionp)
                       (objs uid-ident-mapp))
    :returns (result enumerp)
    (enumer
     (c$::enumer->name enumer)
     (const-expr-option-peel (c$::enumer->value? enumer)
                             dir? objs))
    :measure (enumer-count enumer))

  (define enumer-list-peel ((enumer-list enumer-listp)
                            (dir? direction-optionp)
                            (objs uid-ident-mapp))
    :returns (result enumer-listp)
    (if (endp enumer-list)
        nil
      (cons (enumer-peel (car enumer-list)
                         dir? objs)
            (enumer-list-peel (cdr enumer-list)
                              dir? objs)))
    :measure (enumer-list-count enumer-list))

  (define statassert-peel ((statassert statassertp)
                           (dir? direction-optionp)
                           (objs uid-ident-mapp))
    :returns (result statassertp)
    (statassert
     (const-expr-peel (c$::statassert->test statassert)
                      dir? objs)
     (c$::statassert->message statassert))
    :measure (statassert-count statassert))

  (define attrib-peel ((attrib c$::attribp)
                       (dir? direction-optionp)
                       (objs uid-ident-mapp))
    :returns (result c$::attribp)
    (c$::attrib-case
     attrib
     :name (c$::attrib-fix attrib)
     :name-params
     (c$::attrib-name-params (c$::attrib-name-params->name attrib)
                             (expr-list-peel
                               (c$::attrib-name-params->params attrib)
                               dir? objs)))
    :measure (c$::attrib-count attrib))

  (define attrib-list-peel
    ((attrib-list c$::attrib-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result c$::attrib-listp)
    (if (endp attrib-list)
        nil
      (cons (attrib-peel (car attrib-list)
                         dir? objs)
            (attrib-list-peel (cdr attrib-list)
                              dir? objs)))
    :measure (c$::attrib-list-count attrib-list))

  (define attrib-spec-peel
    ((attrib-spec c$::attrib-specp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result c$::attrib-specp)
    (c$::attrib-spec (c$::attrib-spec->uscores attrib-spec)
                     (attrib-list-peel
                       (c$::attrib-spec->attribs attrib-spec)
                       dir? objs))
    :measure (c$::attrib-spec-count attrib-spec))

  (define attrib-spec-list-peel
    ((attrib-spec-list attrib-spec-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result attrib-spec-listp)
    (if (endp attrib-spec-list)
        nil
      (cons (attrib-spec-peel (car attrib-spec-list)
                              dir? objs)
            (attrib-spec-list-peel (cdr attrib-spec-list)
                                   dir? objs)))
    :measure (c$::attrib-spec-list-count attrib-spec-list))

  (define init-declor-peel ((init-declor init-declorp)
                            (dir? direction-optionp)
                            (objs uid-ident-mapp))
    :returns (result init-declorp)
    (init-declor
     (declor-peel (init-declor->declor init-declor)
                  dir? objs)
     (c$::init-declor->asm? init-declor)
     (attrib-spec-list-peel
       (c$::init-declor->attribs init-declor)
       dir? objs)
     (initer-option-peel (init-declor->initer? init-declor)
                         dir? objs)
     (c$::init-declor->info init-declor))
    :measure (init-declor-count init-declor))

  (define init-declor-list-peel
    ((init-declor-list init-declor-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result init-declor-listp)
    (if (endp init-declor-list)
        nil
      (cons (init-declor-peel (car init-declor-list)
                              dir? objs)
            (init-declor-list-peel (cdr init-declor-list)
                                   dir? objs)))
    :measure (init-declor-list-count init-declor-list))

  (define declon-peel ((declon declonp)
                       (dir? direction-optionp)
                       (objs uid-ident-mapp))
    :returns (result declonp)
    (declon-case
     declon
     :declon
     (declon-declon
       (declon-declon->extension declon)
       (decl-spec-list-peel (declon-declon->specs declon)
                            dir? objs)
       (init-declor-list-peel (declon-declon->declors declon)
                              dir? objs))
     :statassert
     (declon-statassert (statassert-peel
                          (c$::declon-statassert->statassert declon)
                          dir? objs)))
    :measure (declon-count declon))

  (define declon-list-peel ((declon-list declon-listp)
                            (dir? direction-optionp)
                            (objs uid-ident-mapp))
    :returns (result declon-listp)
    (if (endp declon-list)
        nil
      (cons (declon-peel (car declon-list)
                         dir? objs)
            (declon-list-peel (cdr declon-list)
                              dir? objs)))
    :measure (declon-list-count declon-list))

  (define label-peel ((label labelp)
                      (dir? direction-optionp)
                      (objs uid-ident-mapp))
    :returns (result labelp)
    (label-case
     label
     :name (c$::label-name (c$::label-name->name label)
                           (attrib-spec-list-peel
                             (c$::label-name->attribs label)
                             dir? objs))
     :casexpr
     (c$::label-casexpr
       (const-expr-peel (c$::label-casexpr->expr label)
                        dir? objs)
       (const-expr-option-peel
         (c$::label-casexpr->range? label)
         dir? objs))
     :default (label-fix label))
    :measure (label-count label))

  (define asm-output-peel ((asm-output c$::asm-outputp)
                           (dir? direction-optionp)
                           (objs uid-ident-mapp))
    :returns (result c$::asm-outputp)
    (c$::asm-output
     (c$::asm-output->name? asm-output)
     (c$::asm-output->constraint asm-output)
     (expr-peel (c$::asm-output->lvalue asm-output)
                dir? objs))
    :measure (c$::asm-output-count asm-output))

  (define asm-output-list-peel
    ((asm-output-list c$::asm-output-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result c$::asm-output-listp)
    (if (endp asm-output-list)
        nil
      (cons (asm-output-peel (car asm-output-list)
                             dir? objs)
            (asm-output-list-peel (cdr asm-output-list)
                                  dir? objs)))
    :measure (c$::asm-output-list-count asm-output-list))

  (define asm-input-peel ((asm-input c$::asm-inputp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result c$::asm-inputp)
    (c$::asm-input
     (c$::asm-input->name? asm-input)
     (c$::asm-input->constraint asm-input)
     (expr-peel (c$::asm-input->rvalue asm-input)
                dir? objs))
    :measure (c$::asm-input-count asm-input))

  (define asm-input-list-peel
    ((asm-input-list c$::asm-input-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result c$::asm-input-listp)
    (if (endp asm-input-list)
        nil
      (cons (asm-input-peel (car asm-input-list)
                            dir? objs)
            (asm-input-list-peel (cdr asm-input-list)
                                 dir? objs)))
    :measure (c$::asm-input-list-count asm-input-list))

  (define asm-stmt-peel ((asm-stmt c$::asm-stmtp)
                         (dir? direction-optionp)
                         (objs uid-ident-mapp))
    :returns (result c$::asm-stmtp)
    (c$::asm-stmt
     (c$::asm-stmt->uscores asm-stmt)
     (c$::asm-stmt->quals asm-stmt)
     (c$::asm-stmt->template asm-stmt)
     (c$::asm-stmt->num-colons asm-stmt)
     (asm-output-list-peel
       (c$::asm-stmt->outputs asm-stmt)
       dir? objs)
     (asm-input-list-peel (c$::asm-stmt->inputs asm-stmt)
                          dir? objs)
     (c$::asm-stmt->clobbers asm-stmt)
     (c$::asm-stmt->labels asm-stmt))
    :measure (c$::asm-stmt-count asm-stmt))

  (define stmt-peel ((stmt stmtp)
                     (dir? direction-optionp)
                     (objs uid-ident-mapp))
    :returns (result stmtp)
    (stmt-case
     stmt
     :labeled
     (c$::stmt-labeled
       (label-peel (c$::stmt-labeled->label stmt)
                   dir? objs)
       (stmt-peel (c$::stmt-labeled->stmt stmt)
                  dir? objs))
     :compound
     (stmt-compound
       (comp-stmt-peel (stmt-compound->stmt stmt)
                       dir? objs))
     :expr
     (stmt-expr
       (expr-option-peel (c$::stmt-expr->expr? stmt)
                         dir? objs)
       (c$::stmt-expr->info stmt))
     :null-attrib
     (stmt-null-attrib (attrib-spec-peel
                         (c$::stmt-null-attrib->attrib stmt)
                         dir? objs))
     :if (stmt-if (expr-peel (c$::stmt-if->test stmt)
                             dir? objs)
                  (stmt-peel (c$::stmt-if->then stmt)
                             dir? objs))
     :ifelse
     (stmt-ifelse (expr-peel (c$::stmt-ifelse->test stmt)
                             dir? objs)
                  (stmt-peel (c$::stmt-ifelse->then stmt)
                             dir? objs)
                  (stmt-peel (c$::stmt-ifelse->else stmt)
                             dir? objs))
     :switch
     (c$::stmt-switch
       (expr-peel (c$::stmt-switch->target stmt)
                  dir? objs)
       (stmt-peel (c$::stmt-switch->body stmt)
                  dir? objs))
     :while
     (stmt-while (expr-peel (c$::stmt-while->test stmt)
                            dir? objs)
                 (stmt-peel (c$::stmt-while->body stmt)
                            dir? objs))
     :dowhile
     (stmt-dowhile
       (stmt-peel (c$::stmt-dowhile->body stmt)
                  dir? objs)
       (expr-peel (c$::stmt-dowhile->test stmt)
                  dir? objs))
     :for-expr
     (c$::stmt-for-expr
       (expr-option-peel (c$::stmt-for-expr->init stmt)
                         dir? objs)
       (expr-option-peel (c$::stmt-for-expr->test stmt)
                         dir? objs)
       (expr-option-peel (c$::stmt-for-expr->next stmt)
                         dir? objs)
       (stmt-peel (c$::stmt-for-expr->body stmt)
                  dir? objs))
     :for-declon
     (c$::stmt-for-declon
       (declon-peel (c$::stmt-for-declon->init stmt)
                    dir? objs)
       (expr-option-peel (c$::stmt-for-declon->test stmt)
                         dir? objs)
       (expr-option-peel (c$::stmt-for-declon->next stmt)
                         dir? objs)
       (stmt-peel (c$::stmt-for-declon->body stmt)
                  dir? objs))
     :goto (stmt-fix stmt)
     :gotoe
     (stmt-gotoe (expr-peel (c$::stmt-gotoe->label stmt)
                            dir? objs))
     :continue (stmt-fix stmt)
     :break (stmt-fix stmt)
     :return
     (stmt-return
       (expr-option-peel (c$::stmt-return->expr? stmt)
                         dir? objs)
       (c$::stmt-return->info stmt))
     :return-attrib
     (stmt-return-attrib
       (attrib-spec-peel
         (c$::stmt-return-attrib->attrib stmt)
         dir? objs)
       (expr-peel (c$::stmt-return-attrib->expr stmt)
                  dir? objs))
     :asm (c$::stmt-asm
            (asm-stmt-peel (c$::stmt-asm->stmt stmt)
                           dir? objs))
     :for-ambig (stmt-fix stmt))
    :measure (stmt-count stmt))

  (define comp-stmt-peel ((comp-stmt comp-stmtp)
                          (dir? direction-optionp)
                          (objs uid-ident-mapp))
    :returns (result comp-stmtp)
    (comp-stmt
     (comp-stmt->labels comp-stmt)
     (block-item-list-peel (comp-stmt->items comp-stmt)
                           dir? objs))
    :measure (comp-stmt-count comp-stmt))

  (define block-item-peel ((block-item block-itemp)
                           (dir? direction-optionp)
                           (objs uid-ident-mapp))
    :returns (result block-itemp)
    (block-item-case
     block-item
     :declon
     (block-item-declon (declon-peel
                          (c$::block-item-declon->declon block-item)
                          dir? objs)
                        (c$::block-item-declon->info block-item))
     :stmt
     (block-item-stmt
       (stmt-peel (c$::block-item-stmt->stmt block-item)
                  dir? objs)
       (c$::block-item-stmt->info block-item))
     :ambig (block-item-fix block-item))
    :measure (block-item-count block-item))

  (define block-item-list-peel
    ((block-item-list block-item-listp)
     (dir? direction-optionp)
     (objs uid-ident-mapp))
    :returns (result block-item-listp)
    (if (endp block-item-list)
        nil
      (cons (block-item-peel (car block-item-list)
                             dir? objs)
            (block-item-list-peel (cdr block-item-list)
                                  dir? objs)))
    :measure (block-item-list-count block-item-list))

  :verify-guards :after-returns
  ;; :flag-local nil
  )
