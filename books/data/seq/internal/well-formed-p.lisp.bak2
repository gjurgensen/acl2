;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define elem-well-formed-p
  ((depth natp)
   elem)
  (declare (xargs :split-types t)
           (type unsigned-byte depth))
  :returns (yes/no booleanp :rule-classes :type-prescription)
  (and (elem-depth-p depth elem)
       (or (nat-equal depth 0)
           (and .
                (equal (node->len elem) (elem-len depth elem)))))

;;;;;;;;;;;;;;;;;;;;

(in-theory (disable (:t elem-well-formed-p)))

(defrule elem-well-formed-p-when-nat-equiv-congruence
  (implies (nat-equiv depth0 depth1)
           (equal (elem-well-formed-p depth0 elem)
                  (elem-well-formed-p depth1 elem)))
  :rule-classes :congruence
  :enable (elem-well-formed-p
           nfix))

(defruled elem-well-formed-p-when-not-natp
  (implies (not (natp depth))
           (equal (elem-well-formed-p depth elem)
                  t))
  :enable elem-well-formed-p)

(defrule elem-well-formed-p-when-not-natp-cheap
  (implies (not (natp depth))
           (equal (elem-well-formed-p depth elem)
                  t))
  :rule-classes ((:rewrite :backchain-limit-lst (0)))
  :by elem-well-formed-p-when-not-natp)

(defrule elem-well-formed-p-when-not-natp-type-prescription
  (implies (not (natp depth))
           (equal (elem-well-formed-p depth elem)
                  t))
  :rule-classes :type-prescription)

(defrule elem-well-formed-p-of-0
  (elem-well-formed-p 0 elem)
  :enable elem-well-formed-p)

(defruled nodep-when-depth-not-0-and-elem-well-formed-p
  (implies (and (not (equal (nfix depth) 0))
                (elem-well-formed-p depth node))
           (nodep node))
  :enable elem-well-formed-p)

(defrule nodep-when-depth-not-0-and-elem-well-formed-p-cheap
  (implies (and (elem-well-formed-p depth node)
                (not (equal (nfix depth) 0)))
           (nodep node))
  :rule-classes ((:rewrite :backchain-limit-lst (0 nil)))
  :by nodep-when-depth-not-0-and-elem-well-formed-p)

(defrule elem-well-formed-p-of-node->fst
  (implies (elem-well-formed-p (+ 1 (nfix depth)) node)
           (elem-well-formed-p depth (node->fst node)))
  :enable elem-well-formed-p)

(defrule elem-well-formed-p-of-node2->snd
  (implies (and (node2p node)
                (elem-well-formed-p (+ 1 (nfix depth)) node))
           (elem-well-formed-p depth (node2->snd node)))
  :enable elem-well-formed-p)

(defrule elem-well-formed-p-of-node3->snd
  (implies (and (not (node2p node))
                (elem-well-formed-p (+ 1 (nfix depth)) node))
           (elem-well-formed-p depth (node3->snd node)))
  :enable elem-well-formed-p)

(defrule elem-well-formed-p-of-node3->thd
  (implies (and (not (node2p node))
                (elem-well-formed-p (+ 1 (nfix depth)) node))
           (elem-well-formed-p depth (node3->thd node)))
  :enable elem-well-formed-p)

(defrule elem-well-formed-p-of-node2
  (equal (elem-well-formed-p depth (node2 len a b))
         (or (equal (nfix depth) 0)
             (and (elem-well-formed-p (- (nfix depth) 1) a)
                  (elem-well-formed-p (- (nfix depth) 1) b))))
  :enable elem-well-formed-p)

(defrule elem-well-formed-p-of-node3
  (equal (elem-well-formed-p depth (node3 len a b c))
         (or (equal (nfix depth) 0)
             (and (elem-well-formed-p (- (nfix depth) 1) a)
                  (elem-well-formed-p (- (nfix depth) 1) b)
                  (elem-well-formed-p (- (nfix depth) 1) c))))
  :enable elem-well-formed-p)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; TODO: in the optimized version, probably do it at the same time as the
;; digitp check.
(define digit-well-formed?
  ((depth natp)
   (digit digitp))
  (declare (xargs :split-types t)
           (type unsigned-byte depth))
  :returns (len? (or (not len?) (natp len?)) :rule-classes :type-prescription)
  (and (digit-depth-p depth digit)
       (equal (digit->len digit) (digit-len depth digit))
       (digit->len digit))
