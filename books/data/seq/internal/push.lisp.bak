;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define digit-push-node-front
  ((a nodep)
   (digit digitp))
  :guard (mbe :logic (not (equal (digit-case digit) 4))
              :exec (not (= (the (integer 1 4) (digit-case digit)) 4)))
  :returns (digit$ digitp :rule-classes (:rewrite :type-prescription))
  (let ((len (+ (the unsigned-byte (digit->len digit))
                (the unsigned-byte (node->len a)))))
    (case (digit-case digit)
      (1 (digit len a (digit1->fst digit)))
      (2 (digit len a (digit2->fst digit) (digit2->snd digit)))
      (3 (digit len a (digit3->fst digit) (digit3->snd digit) (digit3->thd digit)))
      (otherwise (the nil (digit-fix digit)))))
  :inline t)

;;;;;;;;;;;;;;;;;;;;

(in-theory (disable (:t digit-push-node-front)))

(defrule digit-push-node-front-when-digit-equal-congruence
  (implies (digit-equal digit0 digit1)
           (equal (digit-push-node-front a digit0)
                  (digit-push-node-front a digit1)))
  :rule-classes :congruence
  :enable digit-push-node-front)

(defrule digit-case-of-digit-push-node-front-min-linear
  (<= 2 (digit-case (digit-push-node-front a digit)))
  :rule-classes :linear
  :enable digit-push-node-front)

(defrule digit-depth-p-of-digit-push-node-front
  (implies (and (digit-depth-p depth digit)
                (elem-depth-p depth a))
           (digit-depth-p depth (digit-push-node-front a digit)))
  :enable (digit-push-node-front
           digit-depth-p))

(defrule digit-len-invariant-p-of-digit-push-node-node-front
  (implies (and (digit-len-invariant-p depth digit)
                (elem-len-invariant-p depth a)
                (not (equal (nfix depth) 0)))
           (digit-len-invariant-p depth (digit-push-node-front a digit)))
  :expand ((elem-len-invariant-p depth a))
  :enable (digit-push-node-front
           digit-len-invariant-p
           digit-len
           nfix))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define digit-push-front
  (a
   (digit digitp))
  :guard (mbe :logic (not (equal (digit-case digit) 4))
              :exec (not (= (the (integer 1 4) (digit-case digit)) 4)))
  :returns (digit$ digitp :rule-classes (:rewrite :type-prescription))
  (let ((len (+ (the unsigned-byte (digit->len digit)) 1)))
    (case (digit-case digit)
      (1 (digit len a (digit1->fst digit)))
      (2 (digit len a (digit2->fst digit) (digit2->snd digit)))
      (3 (digit len a (digit3->fst digit) (digit3->snd digit) (digit3->thd digit)))
      (otherwise (the nil (digit-fix digit)))))
  :inline t)

;;;;;;;;;;;;;;;;;;;;

(in-theory (disable (:t digit-push-front)))

(defrule digit-push-front-when-digit-equal-congruence
  (implies (digit-equal digit0 digit1)
           (equal (digit-push-front a digit0)
                  (digit-push-front a digit1)))
  :rule-classes :congruence
  :enable digit-push-front)

(defrule digit-case-of-digit-push-front-min-linear
  (<= 2 (digit-case (digit-push-front a digit)))
  :rule-classes :linear
  :enable digit-push-front)

(defrule digit-depth-p-of-digit-push-front
  (implies (and (digit-depth-p depth digit)
                (elem-depth-p depth a))
           (digit-depth-p depth (digit-push-front a digit)))
  :enable (digit-push-front
           digit-depth-p))

(defrule digit-len-invariant-p-of-digit-push-front
  (implies (digit-len-invariant-p 0 digit)
           (digit-len-invariant-p 0 (digit-push-front a digit)))
  :enable (digit-push-front
           digit-len-invariant-p
           nfix
           digit-len))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define ftree-push-node-front
  ((a nodep)
   (tree ftreep))
  :guard (ftree-depth-p 1 tree)
  :returns (tree$ ftreep)
  (cond ((ftree-empty-p tree)
         (ftree-single a))
        ((ftree-single-p tree)
         (ftree-deep$ (digit$node a)
                      nil
                      (digit$node (ftree-single->elem tree))))
        (t
         (let* ((prefix (ftree-deep->prefix tree)))
           (if (= (mbe :logic (digit-case prefix)
                       :exec (the (integer 1 4) (digit-case prefix)))
                  4)
               (ftree-deep$ (digit$node a (digit4->fst prefix))
                            (ftree-push-node-front
                              (node$node (digit4->snd prefix)
                                         (digit4->thd prefix)
                                         (digit4->frth prefix))
                              (ftree-deep->middle tree))
                            (ftree-deep->suffix tree))
             (ftree-deep$ (digit-push-node-front a prefix)
                          (ftree-deep->middle tree)
                          (ftree-deep->suffix tree))))))
  ;; Verified below
  :verify-guards nil)

