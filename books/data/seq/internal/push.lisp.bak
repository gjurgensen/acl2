;;   :rule-classes ((:rewrite :backchain-limit-lst (0)))
;;   :enable elem-len-invariant-p)

(rule
  (implies
    (and (not (ftree-empty-p tree))
         (not (ftree-single-p tree))
         (equal (digit-case (ftree-deep->prefix tree))
                1)
         (elem-len-invariant-p depth
                               (digit1->fst (ftree-deep->prefix tree)))
         (equal (digit->len (ftree-deep->prefix tree))
                (digit-len depth (ftree-deep->prefix tree)))
         (equal (digit-case (ftree-deep->suffix tree))
                1)
         (elem-len-invariant-p depth
                               (digit1->fst (ftree-deep->suffix tree)))
         (equal (digit->len (ftree-deep->suffix tree))
                (digit-len depth (ftree-deep->suffix tree)))
         (ftree-len-invariant-p (+ 1 depth)
                                (ftree-deep->middle tree))
         (equal (ftree-deep->len tree)
                (+ (digit->len (ftree-deep->prefix tree))
                   (digit->len (ftree-deep->suffix tree))
                   (ftree-len (+ 1 depth)
                              (ftree-deep->middle tree))))
         (elem-len-invariant-p depth a)
         (integerp depth)
         (<= 0 depth)
         (not (equal depth 0))
         (ftree-depth-p 1 tree))
    (equal (+ (ftree-deep->len tree) (node->len a))
           (+ (digit->len (ftree-deep->suffix tree))
              (ftree-len (+ 1 depth)
                         (ftree-deep->middle tree))
              (digit-len depth
                         (digit-push-node-front a (ftree-deep->prefix
                                                    tree))))))
  ;; :expand (elem-len-invariant-p depth a)
  :enable (ftree-push-node-front
           ftree-len-invariant-p
           digit-len-invariant-p
           nfix
           ftree-len
           digit-len
           ))

;;;;;;;;;;

(defrule ftree-len-invariant-p-of-ftree-push-node-front
  (implies (and (ftree-len-invariant-p depth tree)
                (elem-len-invariant-p depth a)
                (not (equal (nfix depth) 0))
                (ftree-depth-p 1 tree)
                )
           (ftree-len-invariant-p depth (ftree-push-node-front a tree)))
  :induct t
  :enable (ftree-push-node-front
           ftree-len-invariant-p
           nfix
           ftree-len

           ;; digit-len-invariant-p
           ;; elem-len-invariant-p
           ;; digit-len
           ;; elem-len
           ))

