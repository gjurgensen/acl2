;;;;;;;;;;;;;;;;;;;;

(in-theory (disable (:t ftree-push-node-front)))

(defrule ftree-push-node-front-type-prescription
  (consp (ftree-push-node-front a tree))
  :rule-classes :type-prescription
  :expand (ftree-push-node-front a tree))

(defrule ftree-push-node-front-when-ftree-equal-congruence
  (implies (ftree-equal tree0 tree1)
           (equal (ftree-push-node-front a tree0)
                  (ftree-push-node-front a tree1)))
  :rule-classes :congruence
  :expand ((ftree-push-node-front a tree0)
           (ftree-push-node-front a tree1)))

(defrule ftree-empty-p-of-ftree-push-node-front
  (not (ftree-empty-p (ftree-push-node-front a tree)))
  :expand (ftree-push-node-front a tree))

(defrule ftree-depth-p-of-ftree-push-node-front
  (implies (and (ftree-depth-p depth tree)
                (elem-depth-p depth a))
           (ftree-depth-p depth (ftree-push-node-front a tree)))
  :induct t
  :enable (ftree-push-node-front
           ftree-depth-p
           nfix))

