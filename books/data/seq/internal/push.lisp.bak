;;   (implies (not (equal (nfix depth) 0))
;;            (equal (elem-len-invariant-p depth elem)
;;                   (and (elem-len-invariant-p (- (nfix depth) 1)
;;                                              (node->fst elem))
;;                        (if (node2p elem)
;;                            (elem-len-invariant-p (- (nfix depth) 1)
;;                                                  (node2->snd elem))
;;                          (and (elem-len-invariant-p (- (nfix depth) 1)
;;                                                     (node3->snd elem))
;;                               (elem-len-invariant-p (- (nfix depth) 1)
