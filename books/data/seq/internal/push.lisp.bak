;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define ftree-push-front
  (a
   (tree ftreep))
  :returns (tree$ ftreep)
  (cond ((ftree-empty-p tree)
         (ftree-single a))
        ((ftree-single-p tree)
         (ftree-deep (digit a)
                     nil
                     (digit (ftree-single->elem tree))))
        (t
         (let ((prefix (ftree-deep->prefix tree)))
           (if (= (mbe :logic (digit-case prefix)
                       :exec (the (integer 1 4) (digit-case prefix)))
                  4)
               (ftree-deep (digit a (digit->fst prefix))
                           (ftree-push-front
                             (node (digit->snd prefix)
                                   (digit->thd prefix)
                                   (digit->frth prefix))
                             (ftree-deep->middle tree))
                           (ftree-deep->suffix tree))
             (ftree-deep (digit-push-front a prefix)
                         (ftree-deep->middle tree)
                         (ftree-deep->suffix tree))))))
  :verify-guards :after-returns)

;;;;;;;;;;;;;;;;;;;;

(in-theory (disable (:t ftree-push-front)))

(defrule ftree-push-front-type-prescription
  (consp (ftree-push-front a tree))
  :rule-classes :type-prescription
  :expand (ftree-push-front a tree))

(defrule ftree-push-front-when-ftree-equal-congruence
  (implies (ftree-equal tree0 tree1)
           (equal (ftree-push-front a tree0)
                  (ftree-push-front a tree1)))
  :rule-classes :congruence
  :expand ((ftree-push-front a tree0)
           (ftree-push-front a tree1)))

(defrule ftree-empty-p-of-ftree-push-front
  (not (ftree-empty-p (ftree-push-front a tree)))
  :expand (ftree-push-front a tree))

(defrule ftree-well-formed-p-of-ftree-push-front
  (implies (and (ftree-well-formed-p depth tree)
                (node?-depth-p depth a))
           (ftree-well-formed-p depth (ftree-push-front a tree)))
  :induct t
  :enable (ftree-push-front
           ftree-well-formed-p
           nfix))

;; (defrule ftree-well-formed-p-of-0-and-ftree-push-front
;;   (implies (ftree-well-formed-p 0 tree)
;;            (ftree-well-formed-p 0 (ftree-push-front a tree))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; TODO: optimize
(define digit-push-back
  (a
   (digit digitp))
  :guard (mbe :logic (not (equal (digit-case digit) 4))
              :exec (not (= (the (integer 1 4) (digit-case digit)) 4)))
  :returns (digit$ digitp :rule-classes (:rewrite :type-prescription))
  (case (digit-case digit)
    (1 (digit (digit->fst digit) a))
    (2 (digit (digit->fst digit) (digit->snd digit) a))
    (3 (digit (digit->fst digit) (digit->snd digit) (digit->thd digit) a))
    (otherwise (the nil (digit-fix digit))))
  :inline t)

;;;;;;;;;;;;;;;;;;;;

(in-theory (disable (:t digit-push-back)))

(defrule digit-push-back-when-digit-equal-congruence
  (implies (digit-equal digit0 digit1)
           (equal (digit-push-back a digit0)
                  (digit-push-back a digit1)))
  :rule-classes :congruence
  :enable digit-push-back)

(defrule digit-case-of-digit-push-back-min-linear
  (<= 2 (digit-case (digit-push-back a digit)))
  :rule-classes :linear
  :enable digit-push-back)

(defrule digit-depth-p-of-digit-push-back
  (implies (and (digit-depth-p depth digit)
                (node?-depth-p depth a))
           (digit-depth-p depth (digit-push-back a digit)))
  :enable (digit-push-back
           digit-depth-p))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define ftree-push-back
  (a
   (tree ftreep))
  :returns (tree$ ftreep)
  (cond ((ftree-empty-p tree)
         (ftree-single a))
        ((ftree-single-p tree)
         (ftree-deep (digit (ftree-single->elem tree))
                     nil
                     (digit a)))
        (t
         (let ((suffix (ftree-deep->suffix tree)))
           (if (= (mbe :logic (digit-case suffix)
                       :exec (the (integer 1 4) (digit-case suffix)))
                  4)
               (ftree-deep (ftree-deep->prefix tree)
                           (ftree-push-back
                             (node (digit->fst suffix)
                                   (digit->snd suffix)
                                   (digit->thd suffix))
                             (ftree-deep->middle tree))
                           (digit (digit->frth suffix) a))
             (ftree-deep (ftree-deep->prefix tree)
                         (ftree-deep->middle tree)
                         (digit-push-back a suffix))))))
  :verify-guards :after-returns)

;;;;;;;;;;;;;;;;;;;;

(in-theory (disable (:t ftree-push-back)))

(defrule ftree-push-back-type-prescription
  (consp (ftree-push-back a tree))
  :rule-classes :type-prescription
  :expand (ftree-push-back a tree))

(defrule ftree-push-back-when-ftree-equal-congruence
  (implies (ftree-equal tree0 tree1)
           (equal (ftree-push-back a tree0)
                  (ftree-push-back a tree1)))
  :rule-classes :congruence
  :expand ((ftree-push-back a tree0)
           (ftree-push-back a tree1)))

(defrule ftree-empty-p-of-ftree-push-back
  (not (ftree-empty-p (ftree-push-back a tree)))
  :expand (ftree-push-back a tree))

(defrule ftree-well-formed-p-of-ftree-push-back
  (implies (and (ftree-well-formed-p depth tree)
                (node?-depth-p depth a))
           (ftree-well-formed-p depth (ftree-push-back a tree)))
  :induct t
  :enable (ftree-push-back
           ftree-well-formed-p
           nfix))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
#|
(define ftree-push-back-list
  ((list true-listp)
   (tree ftreep))
  (if (endp list)
      (ftree-fix tree)
    (ftree-push-back-list (rest list)
                          (ftree-push-back (first list)
                                            tree))))

(define ftree-from-list
  ((list true-listp))
  (ftree-push-back-list list nil)
  :inline t)

;; Oh, this should really be based on push-back
(ftree-from-list '(a b c d e f g h i j k l m n o p q r s t u v w x y z))
